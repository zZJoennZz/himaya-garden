                                   border-l-4 border-l-sage border border-sage/20 bg-cream-warm
                                   p-7 md:p-8"
                        >
                            <h3 class="font-serif text-2xl text-charcoal">
                                The banquet room
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Effortless — and forgettable. Four walls, a
                                folding table, an afternoon that looks like
                                everyone else's.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-1 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-cream-warm
                                   p-7 md:p-8"
                        >
                            <h3 class="font-serif text-2xl text-charcoal">
                                The DIY-at-home
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Personal — and exhausting. Weeks of Pinterest,
                                three trips to the craft store, cooking for 25,
                                praying it comes together.
                            </p>
                        </div>

                        <p
                            class="fade-in delay-2 mt-2 text-center
                                   text-xs uppercase tracking-[0.2em] text-sage font-semibold"
                        >
                            So you choose between forgettable and exhausting.
                            Until now.
                        </p>

                    </div>

                </div>

            -->
                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        A different category of afternoon
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        The Fully-Hosted
                        <span class="block italic text-charcoal/80">
                            Tea Method.
                        </span>
                    </h2>

                    <p
                        class="fade-in delay-2 mx-auto mt-6 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        You make two decisions — a date and a vibe — and we
                        handle every single thing after that. You don't
                        assemble an event. You step into a finished one, built
                        around our signature High Tea Party.
                    </p>

                </div>

            </div>
        </section>


        <!-- =========================================================
            WHAT'S INCLUDED
        ========================================================== -->
        <!-- <section id="included" class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                    md:px-12 lg:px-20 xl:px-32"
            >

                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        Everything that's handled for you
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                            font-serif text-4xl font-light
