---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="The Himaya High Tea Experience | Himaya Garden Tucson"
    description="A fully-styled, fully-staffed signature tea for up to 40 guests — thoughtfully prepared for a stress-free event, with everything ready by the time your guests arrive."
>
    <main>

        <!-- =========================================================
             HERO
        ========================================================== -->
        <section class="relative isolate min-h-[92svh] overflow-hidden bg-warm-white text-charcoal">

            <!-- Background image -->
            <div class="absolute inset-0 opacity-40">
                <img
                    src="/media/img/high tea two women eating at the table.jpeg"
                    alt="A hosted high tea in service at Himaya Garden"
                    class="h-full w-full object-cover object-center"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                />
            </div>

            <!-- Cinematic overlays -->
            <div class="absolute inset-0 bg-white/10"></div>

            <div
                class="absolute inset-0 bg-gradient-to-r
                       from-white/40 via-white/20 to-transparent"
            ></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/30 via-white/5 to-transparent"
            ></div>

            <!-- Subtle texture -->
            <div
                class="absolute inset-0 opacity-[0.045]"
                style="
                    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
                    background-size: 30px 30px;
                "
            ></div>

            <!-- Hero content -->
            <div
                class="relative z-10 flex min-h-[92svh] items-end
                       mx-auto max-w-7xl
                       px-6 pb-16 pt-32
                       md:px-12 md:pb-20
                       lg:px-20 lg:pb-24
                       xl:px-32"
            >
                <div class="max-w-5xl">

                    <div
                        class="fade-in flex items-center gap-3
                               text-xs font-medium uppercase
                               tracking-[0.28em] text-sage
                               md:text-sm"
                    >
                        <span class="h-px w-10 bg-sage/60"></span>
                        The Himaya High Tea Experience
                    </div>

                    <h1
                        class="fade-in delay-1 mt-5 max-w-5xl
                               font-serif text-5xl font-light leading-[0.95]
                               tracking-tight text-charcoal
                               sm:text-6xl
                               md:text-7xl
                               lg:text-8xl
                               xl:text-[7rem]"
                    >
                        Host the afternoon
                        <span class="block italic text-charcoal/80">
                            Tucson won't stop talking about.
                        </span>
                    </h1>

                    <p
                        class="fade-in delay-2 mt-7 max-w-2xl
                               text-base leading-relaxed text-charcoal/75
                               md:text-lg lg:text-xl"
                    >
                        A fully-styled, fully-staffed signature tea for up to 40
                        guests — enjoy a variety of tea along with sweet and
                        savory treats that your guests will love — ready before
                        your first guest arrives, so you can enjoy a stress-free event.
                    </p>

                    <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                        <a
                            href="/contact"
                            class="group inline-flex items-center justify-center
                                   bg-sage px-7 py-4
                                   text-sm font-medium uppercase
                                   tracking-[0.14em] text-warm-white
                                   transition-all duration-300
                                   hover:-translate-y-0.5
                                   hover:bg-sage-dark hover:shadow-xl"
                        >
                            <span>Book a private tea tour</span>
                            <span
                                class="ml-4 transition-transform duration-300
                                       group-hover:translate-x-1"
                            >
                                →
                            </span>
                        </a>

                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-3
                                   px-2 py-4
                                   text-sm uppercase tracking-[0.14em]
                                   text-sage"
                        >
                            <span>Talk to our team</span>
                            <span
                                class="h-px w-8 bg-sage/50
                                       transition-all duration-300
                                       group-hover:w-12 group-hover:bg-sage"
                            ></span>
                        </a>
                    </div>

                    <!-- Experience snapshot -->
                    <div
                        class="fade-in delay-4 mt-10 flex flex-wrap
                               items-center gap-x-7 gap-y-3
                               text-sm text-stone"
                    >
                        <span>Up to 40 guests</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>All Inclusive Price</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>A few private dates each month</span>
                    </div>
                </div>
            </div>

            <!-- Scroll cue -->
            <div
                class="absolute bottom-7 right-6 z-10 hidden
                       items-center gap-3
                       text-[10px] uppercase tracking-[0.25em]
                       text-charcoal/50
                       sm:flex md:right-12
                       lg:right-20 xl:right-32"
            >
                <span>Explore the afternoon</span>
                <span class="h-10 w-px bg-charcoal/20"></span>
            </div>
        </section>


        <!-- =========================================================
             INTRO / POSITIONING
        ========================================================== -->
        <section class="relative overflow-hidden bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="pointer-events-none absolute left-0 top-0
                       h-64 w-64 -translate-x-1/2 -translate-y-1/2
                       rounded-full border border-sage/10"
            ></div>

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >
                <div class="mx-auto max-w-4xl text-center">

                    <p class="section-label fade-in">
                        For the person who's hosting — and quietly dreading it
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        You said yes to hosting.
                        <span class="block italic text-charcoal/80">
                            Not to a second job!
                        </span>
                    </h2>

                    <p
                        class="fade-in delay-2 mx-auto mt-6 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        Somewhere between the yes and today it hit you — the
                        invites, the theme, the food, the rentals, the setup,
                        the timeline, the cleanup all quietly landed on you.
                        And somehow you're meant to be relaxed and present
                        while it happens.
                    </p>

                    <p
                        class="fade-in delay-3 mx-auto mt-5 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        Most of these afternoons end up looking like every
                        other one. Not because the host didn't care — because
                        they ran out of hours. A Himaya High Tea is the other option!
                    </p>

                </div>


                <div class="mt-14 grid gap-5 lg:grid-cols-3">

                    <article
                        class="fade-in group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                ☕
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                A stress free menu
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                No need to worry about catering or making the food yourself. Here at Himaya, we got you covered! We serve a variety of tea, desserts, and savory handheld foods. All you have to do is approve it and enjoy it!
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🌸
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Your own Tea Host
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                A real person owns your timeline, the service,
                                and the details all afternoon — so you're a
                                guest, not a manager.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                ❤️
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                One decision, not twelve
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                No separate caterer, rental company, stylist,
                                and cleanup crew. One date, one vibe, one
                                invoice, fully handled — with tax and gratuity already included.
                            </p>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- =========================================================
             Mini GALLERY
        ========================================================== -->
        <section class="bg-warm-white pb-24 pt-4 md:pb-32 lg:pb-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div
                    class="grid gap-5
                           lg:grid-cols-[1.15fr_1fr_1fr]"
                >

                    <!-- Tall image -->
                    <figure
                        class="fade-in group relative overflow-hidden
                               rounded-sm shadow-lg lg:row-span-1"
                    >
                        <img
                            src="/media/img/event-high-tea.jpg"
                            alt="A wedding celebration in the Himaya Garden"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>


                    <!-- Shorter image -->
                    <figure
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm shadow-lg"
                    >
                        <img
                            src="/media/img/collage-3.jpg"
                            alt="The ceremony lawn at Himaya Garden"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>


                    <!-- Shorter image -->
                    <figure
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm shadow-lg"
                    >
                        <img
                            src="/media/img/high-tea-2.jpg"
                            alt="Guests at a Himaya Garden celebration"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>

                </div>
            </div>
        </section>

        <!-- =========================================================
             THE AFTERNOON / TIMELINE
        ========================================================== -->
        <section class="hidden bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-start gap-14 lg:grid-cols-[0.95fr_1.05fr]">

                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Picture the morning of
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            You don't run the day.
                            <span class="block italic text-charcoal/80">
                                You get to live inside it.
                            </span>
                        </h2>

                        <div class="fade-in delay-2 mt-7 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                No flipping a room in thirty minutes. No "where
                                is the food?" panic. Just an afternoon that
                                arrives already in motion — and asks nothing of
                                you but to enjoy it.
                            </p>
                        </div>

                    </div>


                    <!-- Experience cards -->
                    <div class="grid gap-5">

                        <div
                            class="fade-in relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    The morning of
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    01
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You get ready slowly, hassle free!
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                No car to load with vases and folding chairs.
                                You arrive at Himaya Garden like a guest at
                                your own party.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-1 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Arrival
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    02
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You walk into a finished tea house
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Linens pressed. Room fully set up. Dragonfly Cakes® and Maya tea
                                waiting. Your Tea Host greets you with the day
                                already mapped.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-2 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    The welcome
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    03
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Your guests go quiet — the good kind
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                The kind of quiet that means she really did
                                this. They find their seats, and the afternoon
                                begins exactly on time.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-3 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Two hours
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    04
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You do exactly one job: be present
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Laugh. Sit. Pour. Take the photo. Hug the people
                                you love. Your Tea Host runs the timeline so you
                                never have to glance at a clock.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-4 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    The send-off
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    05
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Every guest leaves with a keepsake
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                A favor in every hand, a
                                styled photo moment captured, a group text
                                already forming.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-4 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    After
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    06
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You leave. No teardown.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                No car full of dishes. Just a phone full of
                                pictures and a message that starts with "that
                                was the most beautiful thing I've ever been to."
                            </p>
                        </div>

                    </div>

                </div>

                <p
                    class="fade-in mt-14 text-center
                           font-serif text-2xl italic leading-relaxed text-charcoal/80
                           md:text-3xl"
                >
                    You don't direct a single vendor.<br>
                    You don't carry a single tray.<br>
                    You just live inside the afternoon.
                </p>

            </div>
        </section>


        <!-- =========================================================
             THE PROBLEM / MECHANISM
        ========================================================== -->
        <section class="hidden bg-warm-white py-20 md:py-24 lg:py-28">
        <!-- 
            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-start gap-14 lg:grid-cols-[0.95fr_1.05fr]">

                    <div>

                        <p class="section-label fade-in">
                            The problem isn't you
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            The real options are
                            <span class="block italic text-charcoal/80">
                                both bad.
                            </span>
                        </h2>

                        <p
                            class="fade-in delay-2 mt-7
                                   text-lg leading-relaxed text-stone"
                        >
                            Every "venue rental" looks the same on paper, so
                            you start price-shopping rooms. But a room isn't
                            what you want. You want the afternoon — the
                            feeling, the photos, the thing people talk about.
