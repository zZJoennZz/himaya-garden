---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Reserve High Tea — Himaya Garden"
    description="Reserve your High Tea experience at Himaya Garden. An afternoon of heritage pastries, botanical teas, and desert blooms in Tucson, Arizona."
>
    <main>
        <!-- Event Hero -->
        <section class="pt-32 pb-20 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="relative rounded-2xl overflow-hidden shadow-lg aspect-[4/3] fade-in">
                        <img 
                            src="https://images.unsplash.com/photo-1559339352-11d035aa65de?w=1200&q=80" 
                            alt="High Tea at Himaya Garden"
                            class="w-full h-full object-cover"
                        />
                        <span class="absolute top-6 left-6 bg-sage text-white text-xs font-medium tracking-[0.15em] uppercase px-4 py-2 rounded-sm">
                            Signature Experience
                        </span>
                    </div>
                    <div class="max-w-xl">
                        <p class="section-label fade-in">Reserve Your Spot</p>
                        <h1 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-tight text-charcoal mb-6">
                            High Tea in the Garden
                        </h1>
                        <div class="fade-in delay-2 font-serif text-3xl text-sage font-medium mb-6">
                            $68 <span class="text-base text-stone font-light font-sans">/ person</span>
                        </div>
                        <p class="fade-in delay-2 text-lg text-stone leading-relaxed mb-6">
                            An afternoon of heritage pastries, botanical teas, and desert blooms. 
                            Rooted in Filipino merienda tradition and reimagined through three generations of bakers.
                        </p>
                        <div class="fade-in delay-3 flex flex-wrap gap-6">
                            <div class="flex items-center gap-2 text-stone">
                                <svg class="w-5 h-5 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                    <line x1="3" y1="10" x2="21" y2="10"/>
                                </svg>
                                <span>Saturday & Sunday</span>
                            </div>
                            <div class="flex items-center gap-2 text-stone">
                                <svg class="w-5 h-5 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <span>2:00 PM – 4:30 PM</span>
                            </div>
                            <div class="flex items-center gap-2 text-stone">
                                <svg class="w-5 h-5 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                                <span>Tucson, Arizona</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Booking Section -->
        <section class="py-24 bg-cream-warm">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-16">
                    <!-- Jotform Embed -->
                    <div class="bg-white rounded-2xl shadow-sm border border-stone/5 overflow-hidden fade-in">
                        <div class="p-8 md:p-10 pb-0 md:pb-0">
                            <h2 class="font-serif text-2xl text-charcoal mb-2">Complete Your Reservation</h2>
                            <p class="text-stone text-lg">Fill in your details below. Payment is processed securely through Jotform.</p>
                        </div>
                        <div class="p-8 md:p-10">
                            <iframe
                                id="JotFormIFrame"
                                title="Himaya Garden - High Tea Reservation"
                                onload="window.parent.scrollTo(0,0)"
                                allowtransparency="true"
                                allowfullscreen="true"
                                allow="geolocation; microphone; camera"
                                src="https://form.jotform.com/YOUR_FORM_ID_HERE"
                                class="w-full min-h-[700px] border-none"
                                scrolling="no"
                            ></iframe>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <aside class="bg-white rounded-2xl p-8 shadow-sm border border-stone/5 h-fit lg:sticky lg:top-24 fade-in delay-2">
                        <h3 class="font-serif text-xl text-charcoal mb-6 pb-6 border-b border-sage/15">Your Reservation</h3>
                        
                        <div class="flex justify-between items-start mb-4 text-base">
                            <div>
                                <div class="text-charcoal font-medium">High Tea Experience</div>
                                <div class="text-stone text-sm font-light mt-0.5">$68 per guest</div>
                            </div>
                            <div class="text-charcoal font-medium whitespace-nowrap">$68</div>
                        </div>

                        <div class="h-px bg-sage/15 my-5"></div>

                        <div class="flex justify-between items-center font-serif text-2xl text-charcoal font-medium mb-6">
                            <span>From</span>
                            <span class="text-sage">$68</span>
                        </div>

                        <p class="text-sm text-stone leading-relaxed mb-6">
                            <svg class="w-4 h-4 inline-block align-text-bottom mr-1 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                            Final total calculated at checkout based on guest count. A 20% gratuity is added automatically.
                        </p>

                        <ul class="space-y-3 my-6">
                            <li class="flex items-start gap-3 text-stone text-base leading-relaxed">
                                <svg class="w-5 h-5 text-sage shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Seasonal pastry tower (3 tiers)
                            </li>
                            <li class="flex items-start gap-3 text-stone text-base leading-relaxed">
                                <svg class="w-5 h-5 text-sage shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Heritage-inspired savory bites
                            </li>
                            <li class="flex items-start gap-3 text-stone text-base leading-relaxed">
                                <svg class="w-5 h-5 text-sage shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Botanical tea selection
                            </li>
                            <li class="flex items-start gap-3 text-stone text-base leading-relaxed">
                                <svg class="w-5 h-5 text-sage shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Garden seating for 2.5 hours
                            </li>
                            <li class="flex items-start gap-3 text-stone text-base leading-relaxed">
                                <svg class="w-5 h-5 text-sage shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Complimentary parking
                            </li>
                        </ul>

                        <div class="flex items-center justify-center gap-2 text-sm text-stone mt-4">
                            <svg class="w-4 h-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4"/>
                            </svg>
                            Secure Checkout via Jotform
                        </div>
                    </aside>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    window.addEventListener('message', function(e) {
        if (e.data && typeof e.data === 'string' && e.data.indexOf('setHeight') > -1) {
            var data = e.data.split(':');
            if (data[0] === 'setHeight') {
                var iframe = document.getElementById('JotFormIFrame');
                if (iframe) {
                    iframe.style.height = data[1] + 'px';
                }
            }
        }
    }, false);
</script>