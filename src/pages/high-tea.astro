---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="High Tea Experience | Himaya Garden Tucson"
    description="Elegant high tea gatherings in Tucson. Choose from Filipino heritage teas or classic Royal High Tea. Book your afternoon tea experience today."
>
    <main>
        <section class="relative isolate min-h-[88svh] overflow-hidden bg-charcoal text-white">
    <!-- Hero image -->
    <div class="absolute inset-0">
        <img
            src="/media/img/high tea two women eating at the table.jpeg"
            alt="Guests enjoying high tea at Himaya Garden"
            class="h-full w-full object-cover object-center"
            fetchpriority="high"
            loading="eager"
            decoding="async"
        />
    </div>

    <!-- Layered overlay -->
    <div class="absolute inset-0 bg-charcoal/35"></div>
    <div
        class="absolute inset-0 bg-gradient-to-r from-charcoal/75 via-charcoal/40 to-charcoal/10"
    ></div>
    <div
        class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-charcoal/20"
    ></div>

    <!-- Subtle botanical texture -->
    <div
        class="absolute inset-0 opacity-[0.08]"
        style="
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
            background-size: 28px 28px;
        "
    ></div>

    <!-- Content -->
    <div
        class="relative z-10 flex min-h-[88svh] items-end
               mx-auto max-w-7xl px-6 pb-16 pt-32
               md:px-12 md:pb-20
               lg:px-20 lg:pb-24
               xl:px-32"
    >
        <div class="max-w-4xl">

            <!-- Eyebrow -->
            <div
                class="fade-in flex items-center gap-3 text-xs
                       font-medium uppercase tracking-[0.28em]
                       text-white/75 md:text-sm"
            >
                <span class="h-px w-10 bg-white/50"></span>
                High Tea at Himaya Garden
            </div>

            <!-- Main heading -->
            <h1
                class="fade-in delay-1 mt-5 max-w-4xl
                       font-serif text-5xl font-light leading-[0.95]
                       tracking-tight text-white
                       sm:text-6xl
                       md:text-7xl
                       lg:text-8xl
                       xl:text-[7rem]"
            >
                An afternoon of
                <span class="block italic text-white/90">
                    elegance & ease.
                </span>
            </h1>

            <!-- Description -->
            <p
                class="fade-in delay-2 mt-7 max-w-2xl
                       text-base leading-relaxed text-white/80
                       md:text-lg lg:text-xl"
            >
                Slow down, sip something beautiful, and share an afternoon
                of conversation, connection, and carefully crafted tea
                experiences.
            </p>

            <!-- CTAs -->
            <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                <a
                    href="/contact"
                    class="group inline-flex items-center justify-center
                           bg-warm-white px-7 py-4
                           text-sm font-medium uppercase tracking-[0.14em]
                           text-charcoal
                           transition-all duration-300
                           hover:bg-white hover:-translate-y-0.5
                           hover:shadow-xl"
                >
                    <span>Reserve Your Tea</span>
                    <span
                        class="ml-4 transition-transform duration-300
                               group-hover:translate-x-1"
                    >
                        →
                    </span>
                </a>

                <a
                    href="/events"
                    class="group inline-flex items-center gap-3
                           px-2 py-4
                           text-sm uppercase tracking-[0.14em]
                           text-white/90"
                >
                    <span>Explore Tea Experiences</span>
                    <span
                        class="h-px w-8 bg-white/50
                               transition-all duration-300
                               group-hover:w-12 group-hover:bg-white"
                    ></span>
                </a>
            </div>

        </div>
    </div>

    <!-- Bottom scroll cue -->
    <div
        class="absolute bottom-7 right-6 z-10 hidden items-center gap-3
               text-[10px] uppercase tracking-[0.25em] text-white/60
               sm:flex md:right-12 lg:right-20 xl:right-32"
    >
        <span>Discover the experience</span>
        <span class="h-10 w-px bg-white/30"></span>
    </div>
</section>
        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center">
                    <p class="section-label fade-in">The high tea tradition</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        A time-honored ritual, reimagined with warmth.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <article class="fade-in border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🫖</div>
                        <h3 class="font-serif text-2xl text-charcoal">Premium teas</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Carefully selected loose-leaf teas from around the world, brewed to perfection by our tea specialists.
                        </p>
                    </article>

                    <article class="fade-in delay-1 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🍰</div>
                        <h3 class="font-serif text-2xl text-charcoal">Artisan pastries</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Handcrafted scones, pastries, finger sandwiches, and sweets made with attention to flavor and presentation.
                        </p>
                    </article>

                    <article class="fade-in delay-2 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🌸</div>
                        <h3 class="font-serif text-2xl text-charcoal">Beautiful setting</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Surrounded by gardens, soft natural light, and tablescapes designed to enhance every moment of your tea.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-2">
                    <div>
                        <p class="section-label fade-in">Two tea traditions</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Choose your tea experience.
                        </h2>
                        <div class="mt-6 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Whether you're drawn to our heritage Filipino tea experience or the classic elegance of Royal High Tea, each offers a unique journey through flavor, culture, and connection.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-6">
                        <div class="fade-in border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">🇵🇭 Filipino Heritage Tea</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">A story of culture</h3>
                            <p class="mt-3 text-stone leading-relaxed">Experience tea traditions passed through generations, featuring ube pastries, Cebuano specialties, and artisan tea blends that honor our heritage.</p>
                        </div>
                        <div class="fade-in delay-1 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">🇬🇧 Royal High Tea</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Classic elegance</h3>
                            <p class="mt-3 text-stone leading-relaxed">The timeless ritual of afternoon tea with tiered presentation, finger sandwiches, pastries, fresh fruit, scones with clotted cream, and premium loose-leaf selections.</p>
                        </div>
                        <div class="fade-in delay-2 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">✨ Seasonal Specials</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Limited editions</h3>
                            <p class="mt-3 text-stone leading-relaxed">Throughout the year, we create special tea experiences celebrating seasonal ingredients and ingredients inspired by the garden's blooms.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">What's included</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Every detail is thoughtfully curated.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    <div class="fade-in bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">☕</div>
                        <h3 class="font-serif text-xl text-charcoal">Premium tea selection</h3>
                        <p class="mt-2 text-sm text-stone">Choice of our carefully curated loose-leaf tea collection</p>
                    </div>
                    <div class="fade-in delay-1 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🍪</div>
                        <h3 class="font-serif text-xl text-charcoal">Artisan pastries</h3>
                        <p class="mt-2 text-sm text-stone">Freshly prepared scones, sandwiches, and handcrafted sweets</p>
                    </div>
                    <div class="fade-in delay-2 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🌿</div>
                        <h3 class="font-serif text-xl text-charcoal">Garden views</h3>
                        <p class="mt-2 text-sm text-stone">Experience the beauty of Himaya's botanical gardens during your tea</p>
                    </div>
                    <div class="fade-in delay-3 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">👥</div>
                        <h3 class="font-serif text-xl text-charcoal">Attentive service</h3>
                        <p class="mt-2 text-sm text-stone">Warm, knowledgeable hospitality throughout your entire experience</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
                    <div class="overflow-hidden rounded-sm">
                        <img src="/media/img/collage-3_4.webp" alt="High tea table setting" class="h-full w-full object-cover" />
                    </div>

                    <div>
                        <p class="section-label fade-in">Perfect for</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Any occasion worth celebrating.
                        </h2>
                        <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                            Whether it's a special celebration, a date with someone you love, or simply taking time to slow down and savor good tea and company, high tea at Himaya Garden is an experience to remember.
                        </p>
                        <ul class="mt-8 space-y-4 text-stone">
                            <li class="flex gap-3"><span class="text-sage">◈</span> Individual reservations welcome</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Group bookings accommodated</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Dietary needs supported</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative overflow-hidden py-32 md:py-40 text-center text-white">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/high tea two women eating at the table.jpeg" alt="High tea gathering" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <p class="section-label text-white/80 fade-in">Ready to pour?</p>
                <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                    Join us for an afternoon of tea and conversation.
                </h2>
                <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                    Reserve your seat for an elevated tea experience surrounded by beauty.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="/contact" class="btn-primary">Reserve Your Tea</a>
                    <a href="/events" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">See Available Times</a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
.fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: fadeInHero 0.7s ease forwards;
}

.fade-in.delay-1 {
    animation-delay: 0.08s;
}

.fade-in.delay-2 {
    animation-delay: 0.16s;
}

.fade-in.delay-3 {
    animation-delay: 0.24s;
}

@keyframes fadeInHero {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .fade-in {
        opacity: 1;
        transform: none;
        animation: none;
    }
}
</style>