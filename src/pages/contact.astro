---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Contact — Himaya Garden"
    description="Get in touch with Himaya Garden. Schedule a tour, inquire about events, or reach out to our team in Tucson, Arizona."
>
    <main>
        <!-- Page Header -->
        <section class="pt-32 pb-20 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 text-center">
                <p class="section-label fade-in">Get In Touch</p>
                <h1 class="fade-in delay-1 font-serif text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight leading-tight text-charcoal mb-6">
                    Contact Us
                </h1>
                <p class="fade-in delay-2 text-lg text-stone leading-relaxed max-w-2xl mx-auto">
                    We'd love to hear from you. Whether you're planning a celebration or just want to learn more about Himaya Garden, our team is here
                    to help.
                </p>
            </div>
        </section>

        <!-- Contact Form & Map -->
        <section class="py-24 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                    <!-- Form -->
                    <div id="form-container">
                        <form id="contact-form" class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-stone/10 h-full">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                                <div>
                                    <label for="first-name" class="block text-charcoal font-medium mb-2">First Name <span class="text-red-500">*</span></label>
                                    <input 
                                        type="text" 
                                        id="first-name" 
                                        name="first_name" 
                                        required
                                        class="w-full px-4 py-3 rounded-xl border border-stone/20 focus:border-sage focus:ring-2 focus:ring-sage/20 outline-none transition"
                                        placeholder="John"
                                    />
                                </div>
                                <div>
                                    <label for="last-name" class="block text-charcoal font-medium mb-2">Last Name <span class="text-red-500">*</span></label>
                                    <input 
                                        type="text" 
                                        id="last-name" 
                                        name="last_name" 
                                        required
                                        class="w-full px-4 py-3 rounded-xl border border-stone/20 focus:border-sage focus:ring-2 focus:ring-sage/20 outline-none transition"
                                        placeholder="Smith"
                                    />
                                </div>
                            </div>

                            <div class="mb-6">
                                <label for="email" class="block text-charcoal font-medium mb-2">Email Address <span class="text-red-500">*</span></label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email" 
                                    required
                                    class="w-full px-4 py-3 rounded-xl border border-stone/20 focus:border-sage focus:ring-2 focus:ring-sage/20 outline-none transition"
                                    placeholder="john.smith@email.com"
                                />
                            </div>

                            <div class="mb-6">
                                <label for="phone" class="block text-charcoal font-medium mb-2">Phone Number <span class="text-red-500">*</span></label>
                                <input 
                                    type="tel" 
                                    id="phone" 
                                    name="phone" 
                                    required
                                    class="w-full px-4 py-3 rounded-xl border border-stone/20 focus:border-sage focus:ring-2 focus:ring-sage/20 outline-none transition"
                                    placeholder="520-467-1033"
                                />
                            </div>

                            <div class="mb-8">
                                <label for="notes" class="block text-charcoal font-medium mb-2">Message / Notes</label>
                                <textarea 
                                    id="notes" 
                                    name="notes" 
                                    rows="5"
                                    class="w-full px-4 py-3 rounded-xl border border-stone/20 focus:border-sage focus:ring-2 focus:ring-sage/20 outline-none transition resize-y"
                                    placeholder="Tell us about your event, preferred dates, or any questions you have..."
                                ></textarea>
                            </div>

                            <button 
                                type="submit" 
                                id="submit-btn"
                                class="w-full px-10 py-3 bg-sage text-white font-medium rounded-xl hover:bg-sage/80 transition-all hover:-translate-y-0.5"
                            >
                                Send Message
                            </button>

                            <!-- Success Message -->
                            <div id="success-message" class="hidden mt-6 p-6 bg-green-50 border border-green-200 rounded-xl">
                                <div class="flex items-start gap-4">
                                    <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4 class="text-green-800 font-medium text-lg">Thank You!</h4>
                                        <p class="text-green-700">Your message has been sent successfully. A member of our team will call you within the next few minutes.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Error Message -->
                            <div id="error-message" class="hidden mt-6 p-6 bg-red-50 border border-red-200 rounded-xl">
                                <div class="flex items-start gap-4">
                                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center text-red-600 shrink-0">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4 class="text-red-800 font-medium text-lg">Something Went Wrong</h4>
                                        <p class="text-red-700">We couldn't send your message. Please try again or contact us directly at info@himayagarden.com.</p>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Map -->
                    <div class="lg:mt-0">
                        <div class="bg-white rounded-2xl p-2 shadow-sm border border-stone/10 h-full flex items-stretch">
                            <iframe 
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3373.068397340664!2d-110.9644244!3d32.283139!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86d6738dbf0304cf%3A0x49e5c66724b20d47!2sHimaya%20Garden!5e0!3m2!1sen!2sph!4v1787227954383!5m2!1sen!2sph" 
                                width="100%" 
                                height="100%" 
                                min-height="450"
                                style="border:0; border-radius: 0.75rem; min-height: 450px;" 
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="strict-origin-when-cross-origin"
                                class="rounded-xl w-full h-full min-h-[450px]"
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Info Cards -->
        <section class="py-24 bg-cream-warm">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
                    <!-- Phone -->
                    <a
                        href="tel:+15204671033"
                        class="group bg-white rounded-2xl p-8 shadow-sm border border-stone/10 text-center hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-14 h-14 mx-auto mb-5 rounded-full bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                >
                                </path>
                            </svg>
                        </div>
                        <h3 class="font-serif text-xl text-charcoal mb-2">Call Us</h3>
                        <p class="text-stone text-sm mb-3">Speak directly with our team</p>
                        <p class="text-sage font-medium">520-467-1033</p>
                    </a>

                    <!-- Email -->
                    <a
                        href="mailto:info@himayagarden.com"
                        class="group bg-white rounded-2xl p-8 shadow-sm border border-stone/10 text-center hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-14 h-14 mx-auto mb-5 rounded-full bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                >
                                </path>
                            </svg>
                        </div>
                        <h3 class="font-serif text-xl text-charcoal mb-2">Email Us</h3>
                        <p class="text-stone text-sm mb-3">We'll respond within 24–48 hours</p>
                        <p class="text-sage font-medium">info@himayagarden.com</p>
                    </a>

                    <!-- Location -->
                    <a
                        href="https://www.google.com/maps/search/?api=1&query=Himaya+Garden+Tucson+AZ"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group bg-white rounded-2xl p-8 shadow-sm border border-stone/10 text-center hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-14 h-14 mx-auto mb-5 rounded-full bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                >
                                </path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <h3 class="font-serif text-xl text-charcoal mb-2">Our Location</h3>
                        <p class="text-stone text-sm mb-3">Tucson, Arizona</p>
                        <p class="text-sage font-medium">Get Directions</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- Quick Links -->
        <section class="py-24 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center mb-16">
                    <h2 class="font-serif text-3xl md:text-4xl text-charcoal mb-4">How Can We Help?</h2>
                    <div class="w-20 h-0.5 bg-sage mx-auto"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
                    <a
                        href="/venue-rates"
                        class="group flex items-center gap-5 bg-white rounded-xl p-6 shadow-sm border border-stone/10 hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all shrink-0"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                >
                                </path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-serif text-lg text-charcoal group-hover:text-sage transition-colors">View Venue Details</h3>
                            <p class="text-stone text-sm">Explore our venue rates and collections</p>
                        </div>
                    </a>

                    <a
                        href="/gallery"
                        class="group flex items-center gap-5 bg-white rounded-xl p-6 shadow-sm border border-stone/10 hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all shrink-0"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                >
                                </path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-serif text-lg text-charcoal group-hover:text-sage transition-colors">See the Gallery</h3>
                            <p class="text-stone text-sm">Browse photos of our garden and tea house</p>
                        </div>
                    </a>

                    <a
                        href="/rental-inquiry"
                        class="group flex items-center gap-5 bg-white rounded-xl p-6 shadow-sm border border-stone/10 hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all shrink-0"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                >
                                </path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-serif text-lg text-charcoal group-hover:text-sage transition-colors">Submit an Inquiry</h3>
                            <p class="text-stone text-sm">Start planning your event with us</p>
                        </div>
                    </a>

                    <a
                        href="/about-us"
                        class="group flex items-center gap-5 bg-white rounded-xl p-6 shadow-sm border border-stone/10 hover:-translate-y-1 hover:shadow-md transition-all"
                    >
                        <div
                            class="w-12 h-12 rounded-lg bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all shrink-0"
                        >
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                                >
                                </path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-serif text-lg text-charcoal group-hover:text-sage transition-colors">About Our Story</h3>
                            <p class="text-stone text-sm">Learn about Himaya Garden's heritage</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Hours -->
        <section class="py-24 bg-cream-warm">
            <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 text-center">
                <h2 class="font-serif text-3xl md:text-4xl text-charcoal mb-8">Visit by Appointment</h2>
                <p class="text-stone text-lg leading-relaxed max-w-2xl mx-auto mb-8">
                    We welcome tours and visits by scheduled appointment. Reach out to find a time that works for you.
                </p>
                <div class="bg-sage/5 rounded-2xl p-8 border border-sage/20 inline-block">
                    <p class="text-charcoal font-medium mb-2">Tours Available</p>
                    <p class="text-stone">Monday – Saturday</p>
                    <p class="text-stone">By appointment only</p>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="relative py-32 text-center text-white overflow-hidden">
            <div class="absolute inset-0 z-0">
                <img src="media/img/AG1_4.jpg" alt="Himaya Garden at golden hour" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <h2 class="fade-in font-serif text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">Let's Connect</h2>
                <p class="fade-in delay-1 text-lg leading-relaxed mb-8 text-white/90">
                    Every great celebration starts with a conversation. We can't wait to hear from you.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="tel:+15204671033" class="btn-primary bg-white text-charcoal hover:bg-charcoal hover:text-white transition-all">
                        Call 520-467-1033
                    </a>
                    <a href="/rental-inquiry" class="btn-secondary border-white/30 text-white hover:bg-white hover:text-charcoal transition-all">
                        Submit an Inquiry
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
    // TypeScript interfaces
    interface FormElements {
        firstName: HTMLInputElement;
        lastName: HTMLInputElement;
        email: HTMLInputElement;
        phone: HTMLInputElement;
        notes: HTMLTextAreaElement;
        submitBtn: HTMLButtonElement;
        successMessage: HTMLElement;
        errorMessage: HTMLElement;
        form: HTMLFormElement;
    }

    interface LeadPayload {
        project_id: string;
        lead_reason: string;
        lead_number: string;
        lead_first_name: string;
        lead_last_name: string;
        lead_email: string;
        lead_notes: string;
    }

    // Form configuration
    const CONFIG = {
        PROJECT_ID: 'RMW4DDW', // Replace with your actual project ID
        WEBHOOK_URL: 'https://hook.us2.make.com/5pyx8oqd5jp77b92dz3hfbodrvcqqcwu'
    } as const;

    document.addEventListener('DOMContentLoaded', (): void => {
        // Get form elements with type assertions
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        if (!form) return;

        const elements: FormElements = {
            firstName: document.getElementById('first-name') as HTMLInputElement,
            lastName: document.getElementById('last-name') as HTMLInputElement,
            email: document.getElementById('email') as HTMLInputElement,
            phone: document.getElementById('phone') as HTMLInputElement,
            notes: document.getElementById('notes') as HTMLTextAreaElement,
            submitBtn: document.getElementById('submit-btn') as HTMLButtonElement,
            successMessage: document.getElementById('success-message') as HTMLElement,
            errorMessage: document.getElementById('error-message') as HTMLElement,
            form: form
        };

        // Helper function to format phone number
        const formatPhoneNumber = (phone: string): string => {
            // Remove all non-numeric characters
            const cleanPhone = phone.replace(/\D/g, '');
            
            // If the phone is empty, return as is
            if (!cleanPhone) return phone;
            
            // If it already has a '+', return as is
            if (phone.startsWith('+')) return phone;
            
            // Check if it's a US number (10 digits)
            if (cleanPhone.length === 10) {
                return `+1${cleanPhone}`;
            }
            
            // Check if it's a US number with country code (11 digits starting with 1)
            if (cleanPhone.length === 11 && cleanPhone.startsWith('1')) {
                return `+${cleanPhone}`;
            }
            
            // If it's a different format, try to add + if not present
            return phone.startsWith('+') ? phone : `+${cleanPhone}`;
        };

        // Validate form fields
        const validateForm = (): boolean => {
            const { firstName, lastName, email, phone } = elements;
            
            // Check if all required fields are filled
            if (!firstName.value.trim() || !lastName.value.trim() || !email.value.trim() || !phone.value.trim()) {
                return false;
            }
            
            // Basic email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email.value.trim())) {
                return false;
            }
            
            return true;
        };

        // Show message helper
        const showMessage = (messageElement: HTMLElement): void => {
            const { successMessage, errorMessage } = elements;
            successMessage.classList.add('hidden');
            errorMessage.classList.add('hidden');
            messageElement.classList.remove('hidden');
            
            // Scroll to message
            messageElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        };

        // Handle form submission
        const handleSubmit = async (event: Event): Promise<void> => {
            event.preventDefault();
            
            const { 
                firstName, 
                lastName, 
                email, 
                phone, 
                notes, 
                submitBtn, 
                successMessage, 
                errorMessage 
            } = elements;

            // Hide any previous messages
            successMessage.classList.add('hidden');
            errorMessage.classList.add('hidden');

            // Validate form
            if (!validateForm()) {
                // Show a generic error or highlight fields
                const firstInvalidField = form.querySelector('.border-red-500');
                if (firstInvalidField) {
                    firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return;
            }

            // Disable submit button
            submitBtn.disabled = true;
            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Sending...';

            try {
                // Format phone number
                const formattedPhone = formatPhoneNumber(phone.value.trim());
                
                // Prepare the payload
                const payload: LeadPayload = {
                    project_id: CONFIG.PROJECT_ID,
                    lead_reason: 'web_form',
                    lead_number: formattedPhone,
                    lead_first_name: firstName.value.trim(),
                    lead_last_name: lastName.value.trim(),
                    lead_email: email.value.trim(),
                    lead_notes: notes.value.trim() || 'No additional notes provided'
                };

                // Send the request
                const response = await fetch(CONFIG.WEBHOOK_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    // Success
                    showMessage(successMessage);
                    form.reset();
                } else {
                    throw new Error(`Server responded with status: ${response.status}`);
                }
            } catch (error) {
                console.error('Form submission error:', error);
                showMessage(errorMessage);
            } finally {
                // Re-enable submit button
                submitBtn.disabled = false;
                submitBtn.textContent = originalText || 'Send Message';
            }
        };

        // Add event listener
        form.addEventListener('submit', handleSubmit);

        // Add real-time validation styling
        const validateField = (field: HTMLInputElement | HTMLTextAreaElement): void => {
            if (field.hasAttribute('required') && !field.value.trim()) {
                field.classList.add('border-red-500');
                field.classList.remove('border-stone/20');
            } else {
                field.classList.remove('border-red-500');
                field.classList.add('border-stone/20');
            }
        };

        // Add blur event listeners to required fields for validation feedback
        const requiredFields = form.querySelectorAll('[required]');
        requiredFields.forEach((field) => {
            field.addEventListener('blur', () => {
                validateField(field as HTMLInputElement | HTMLTextAreaElement);
            });
            
            field.addEventListener('input', () => {
                if (field.classList.contains('border-red-500')) {
                    validateField(field as HTMLInputElement | HTMLTextAreaElement);
                }
            });
        });
    });
</script>