---
import BaseLayout from '../../layouts/BaseLayout.astro';
import events from '../../data/events.json';
import EventCard from '../../components/EventCard.astro';

// Generate static paths
export function getStaticPaths() {
  return events.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

// Format date nicely
const eventDate = new Date(event.date + 'T00:00:00');
const formattedDate = eventDate.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const monthShort = eventDate.toLocaleDateString('en-US', { month: 'short' });
const dayNum = eventDate.getDate();

// Check if event is past
const isPast = new Date(event.date + 'T23:59:59') < new Date();

// Get related events (same category, excluding current)
const relatedEvents = events
  .filter(e => e.category === event.category && e.id !== event.id)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 2);

// Fallback: get next upcoming events if no same category
const fallbackRelated = events
  .filter(e => e.id !== event.id && new Date(e.date + 'T23:59:59') >= new Date())
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 2);

const displayRelated = (relatedEvents.length > 0 ? relatedEvents : fallbackRelated).map(
  relatedEvent => ({
    ...relatedEvent,
    spotsAvailable: relatedEvent.spotsAvailable ?? undefined,
    spotsTotal: relatedEvent.spotsTotal ?? undefined,
  })
);

// Spots percentage for visual indicator
const spotsPercent = event.spotsTotal && event.spotsAvailable !== null 
  ? Math.round(((event.spotsTotal - event.spotsAvailable) / event.spotsTotal) * 100)
  : 0;
---

<BaseLayout
  title={`${event.title} — Himaya Garden Events`}
  description={event.shortDescription}
>
  <main>
    <!-- Hero Section -->
    <section class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <div class="absolute inset-0">
        <img 
          src={event.image} 
          alt={event.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-charcoal/40"></div>
      </div>
      
      <div class="relative z-10 h-full flex items-end">
        <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 w-full pb-16 md:pb-24">
          <div class="max-w-3xl">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-white/70 text-sm mb-6">
              <a href="/" class="hover:text-white transition-colors">Home</a>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              <a href="/events" class="hover:text-white transition-colors">Events</a>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              <span class="text-white/50">{event.title}</span>
            </nav>

            <span class="inline-block px-4 py-1.5 bg-sage/90 text-white text-sm font-medium tracking-wider uppercase rounded-full mb-6 backdrop-blur-sm">
              {event.category}
            </span>
            
            <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white font-medium tracking-tight leading-tight mb-6">
              {event.title}
            </h1>

            {isPast && (
              <span class="inline-block px-4 py-2 bg-white/20 text-white text-sm font-medium rounded-full backdrop-blur-sm">
                This event has passed
              </span>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Event Details -->
    <section class="py-16 md:py-24 bg-cream">
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
          <!-- Main Content -->
          <div class="lg:col-span-2">
            <!-- Date Badge (Mobile) -->
            <div class="lg:hidden flex items-center gap-4 mb-8 p-4 bg-white rounded-xl border border-stone/10">
              <div class="w-16 h-16 rounded-xl bg-sage/10 flex flex-col items-center justify-center text-sage shrink-0">
                <span class="text-xs font-medium uppercase tracking-wider">{monthShort}</span>
                <span class="text-2xl font-serif font-medium">{dayNum}</span>
              </div>
              <div>
                <p class="text-charcoal font-medium">{formattedDate}</p>
                <p class="text-stone text-sm">{event.time} – {event.endTime}</p>
              </div>
            </div>

            <h2 class="font-serif text-2xl md:text-3xl text-charcoal mb-6">About This Event</h2>
            <div class="prose prose-stone max-w-none">
              <p class="text-stone leading-relaxed text-lg mb-6">
                {event.description}
              </p>
            </div>

            <!-- Tags -->
            {event.tags && event.tags.length > 0 && (
              <div class="mt-10">
                <h3 class="font-serif text-lg text-charcoal mb-4">Tags</h3>
                <div class="flex flex-wrap gap-2">
                  {event.tags.map(tag => (
                    <span class="px-4 py-2 bg-white rounded-full text-sm text-stone border border-stone/10">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Share -->
            <div class="mt-10 pt-8 border-t border-stone/10">
              <h3 class="font-serif text-lg text-charcoal mb-4">Share This Event</h3>
              <div class="flex items-center gap-3">
                <button 
                  onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}', '_blank', 'width=600,height=400')`}
                  class="w-10 h-10 rounded-full bg-white border border-stone/10 flex items-center justify-center text-stone hover:bg-sage hover:text-white hover:border-sage transition-all"
                  aria-label="Share on Facebook"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </button>
                <button 
                  onclick={`window.open('https://twitter.com/intent/tweet?text=${encodeURIComponent(event.title)}&url=${encodeURIComponent(Astro.url.href)}', '_blank', 'width=600,height=400')`}
                  class="w-10 h-10 rounded-full bg-white border border-stone/10 flex items-center justify-center text-stone hover:bg-sage hover:text-white hover:border-sage transition-all"
                  aria-label="Share on Twitter"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                </button>
                <button 
                  onclick={`navigator.clipboard.writeText('${Astro.url.href}').then(() => alert('Link copied to clipboard!'))`}
                  class="w-10 h-10 rounded-full bg-white border border-stone/10 flex items-center justify-center text-stone hover:bg-sage hover:text-white hover:border-sage transition-all"
                  aria-label="Copy link"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-1">
            <div class="sticky top-32 space-y-6">
              <!-- Date Card -->
              <div class="hidden lg:flex bg-white rounded-2xl p-6 shadow-sm border border-stone/10 items-center gap-5">
                <div class="w-20 h-20 rounded-xl bg-sage/10 flex flex-col items-center justify-center text-sage shrink-0">
                  <span class="text-xs font-medium uppercase tracking-wider">{monthShort}</span>
                  <span class="text-3xl font-serif font-medium">{dayNum}</span>
                </div>
                <div>
                  <p class="text-charcoal font-medium">{formattedDate}</p>
                  <p class="text-stone text-sm">{event.time} – {event.endTime}</p>
                </div>
              </div>

              <!-- Details Card -->
              <div class="bg-white rounded-2xl p-6 shadow-sm border border-stone/10">
                <h3 class="font-serif text-lg text-charcoal mb-5">Event Details</h3>
                <div class="space-y-5">
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-lg bg-sage/10 flex items-center justify-center text-sage shrink-0">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="text-charcoal font-medium text-sm">Location</p>
                      <p class="text-stone text-sm">{event.location}</p>
                      <p class="text-stone text-sm">{event.address}</p>
                    </div>
                  </div>

                  {event.price && (
                    <div class="flex items-start gap-4">
                      <div class="w-10 h-10 rounded-lg bg-sage/10 flex items-center justify-center text-sage shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </div>
                      <div>
                        <p class="text-charcoal font-medium text-sm">Price</p>
                        <p class="text-stone text-sm">{event.price}</p>
                      </div>
                    </div>
                  )}

                  {event.spotsTotal && event.spotsAvailable !== null && (
                    <div class="flex items-start gap-4">
                      <div class="w-10 h-10 rounded-lg bg-sage/10 flex items-center justify-center text-sage shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                      </div>
                      <div class="flex-1">
                        <p class="text-charcoal font-medium text-sm">Availability</p>
                        <p class="text-stone text-sm mb-2">
                          {event.spotsAvailable} of {event.spotsTotal} spots available
                        </p>
                        <div class="w-full h-2 bg-cream rounded-full overflow-hidden">
                          <div 
                            class="h-full bg-sage rounded-full transition-all duration-500"
                            style={`width: ${spotsPercent}%`}
                          ></div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>

              <!-- CTA Card -->
              {!isPast && (
                <div class="bg-sage/5 rounded-2xl p-6 border border-sage/20">
                  <h3 class="font-serif text-lg text-charcoal mb-3">Interested in Attending?</h3>
                  <p class="text-stone text-sm mb-5">
                    Reserve your spot or reach out with any questions about this event.
                  </p>
                  <div class="space-y-3">
                    <a href="/contact" class="btn-primary w-full justify-center">
                      RSVP / Inquire
                    </a>
                    <a 
                      href={`https://www.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.title)}&dates=${event.date.replace(/-/g, '')}T${event.time.replace(/[^0-9]/g, '')}00/${event.date.replace(/-/g, '')}T${event.endTime.replace(/[^0-9]/g, '')}00&details=${encodeURIComponent(event.shortDescription)}&location=${encodeURIComponent(event.location)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary w-full justify-center"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      Add to Calendar
                    </a>
                  </div>
                </div>
              )}

              {isPast && (
                <div class="bg-cream-warm rounded-2xl p-6 border border-stone/10">
                  <h3 class="font-serif text-lg text-charcoal mb-3">Event Has Passed</h3>
                  <p class="text-stone text-sm mb-5">
                    This event has already taken place. Check out our upcoming events or subscribe for notifications.
                  </p>
                  <a href="/events" class="btn-primary w-full justify-center">
                    View Upcoming Events
                  </a>
                </div>
              )}

              <!-- Directions -->
              <a 
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.location + ' ' + event.address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 bg-white rounded-2xl p-6 shadow-sm border border-stone/10 hover:-translate-y-0.5 hover:shadow-md transition-all group"
              >
                <div class="w-12 h-12 rounded-xl bg-sage/10 flex items-center justify-center text-sage group-hover:bg-sage group-hover:text-white transition-all shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 7m0 13V7"/>
                  </svg>
                </div>
                <div>
                  <p class="text-charcoal font-medium text-sm">Get Directions</p>
                  <p class="text-stone text-sm">Open in Google Maps</p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Events -->
    {displayRelated.length > 0 && (
      <section class="py-24 bg-cream-warm">
        <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
          <div class="text-center mb-16">
            <p class="section-label fade-in">You Might Also Like</p>
            <h2 class="fade-in delay-1 font-serif text-3xl md:text-4xl text-charcoal mb-4">
              Related Events
            </h2>
            <div class="w-20 h-0.5 bg-sage mx-auto"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {displayRelated.map((relEvent, index) => (
              <div class="fade-in" style={`transition-delay: ${index * 0.15}s;`}>
                <EventCard event={relEvent} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-24 bg-cream">
      <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 text-center">
        <h2 class="font-serif text-3xl md:text-4xl text-charcoal mb-6">
          Plan Your Own Event
        </h2>
        <p class="text-stone text-lg leading-relaxed max-w-2xl mx-auto mb-10">
          Inspired by what you see? Himaya Garden is the perfect backdrop for weddings, celebrations, and private gatherings.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/rental-inquiry" class="btn-primary">Start Planning</a>
          <a href="/gallery" class="btn-secondary">View Gallery</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>