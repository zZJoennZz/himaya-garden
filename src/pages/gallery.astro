---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Gallery — Himaya Garden"
    description="Explore the beauty of Himaya Garden through our photo gallery. Garden events, tea house gatherings, weddings, and celebrations in Tucson, Arizona."
>
    <main>
        <!-- Page Header -->
        <section class="pt-32 pb-20 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 text-center">
                <p class="section-label fade-in">Visual Stories</p>
                <h1 class="fade-in delay-1 font-serif text-4xl md:text-6xl lg:text-7xl font-medium tracking-tight leading-tight text-charcoal mb-6">
                    Gallery
                </h1>
                <p class="fade-in delay-2 text-lg text-stone leading-relaxed max-w-2xl mx-auto mb-10">
                    Moments captured at Himaya Garden — where every gathering becomes a memory worth keeping.
                </p>

                <!-- Category Filter -->
                <div class="fade-in delay-3 flex flex-wrap justify-center gap-3" id="gallery-filters">
                    <button class="filter-btn active px-6 py-3 rounded-full bg-sage text-white font-medium text-sm tracking-wide transition-all" data-filter="all">All</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="weddings">Weddings</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="graduations">Graduations</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="baby-showers">Baby Showers</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="retreats">Retreats</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="workshops">Workshops</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="community-events-and-markets">Community Events and Markets</button>
                    <button class="filter-btn px-6 py-3 rounded-full bg-sage/10 text-sage hover:bg-sage hover:text-white font-medium text-sm tracking-wide transition-all" data-filter="venue">Venue</button>
                </div>
            </div>
        </section>

