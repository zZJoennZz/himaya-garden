---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="The Edible Arts Lab (TEAL) | Himaya Garden Tucson"
    description="Hands-on edible art classes at Himaya Garden. Paint with buttercream, learn art history, taste the art. Workshops for all creative levels."
>
    <main>
        <section class="relative isolate min-h-[88svh] overflow-hidden bg-charcoal text-white">
    <!-- Hero image -->
    <div class="absolute inset-0">
        <img
            src="/media/img/workshop.webp"
            alt="Guests creating edible art at a TEAL workshop"
            class="h-full w-full object-cover object-center"
            fetchpriority="high"
            loading="eager"
            decoding="async"
        />
    </div>

    <!-- Layered overlay -->
    <div class="absolute inset-0 bg-charcoal/30"></div>

    <div
        class="absolute inset-0 bg-gradient-to-r
               from-charcoal/80 via-charcoal/45 to-charcoal/10"
    ></div>

    <div
        class="absolute inset-0 bg-gradient-to-t
               from-charcoal/70 via-transparent to-charcoal/20"
    ></div>

    <!-- Very subtle texture -->
    <div
        class="absolute inset-0 opacity-[0.06]"
        style="
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
            background-size: 28px 28px;
        "
    ></div>

    <!-- Decorative botanical / artistic accent -->
    <div
        class="absolute right-[-6rem] top-[-6rem]
               h-64 w-64 rounded-full
               border border-white/10
               md:h-96 md:w-96"
    ></div>

    <div
        class="absolute right-[-2rem] top-[-2rem]
               h-40 w-40 rounded-full
               border border-white/10
               md:h-64 md:w-64"
    ></div>

    <!-- Content -->
    <div
        class="relative z-10 flex min-h-[88svh] items-end
               mx-auto max-w-7xl
               px-6 pb-16 pt-32
               md:px-12 md:pb-20
               lg:px-20 lg:pb-24
               xl:px-32"
    >
        <div class="max-w-5xl">

            <!-- Eyebrow -->
            <div
                class="fade-in flex items-center gap-3
                       text-xs font-medium uppercase
                       tracking-[0.28em] text-white/75
                       md:text-sm"
            >
                <span class="h-px w-10 bg-white/50"></span>
                The Edible Arts Lab
            </div>

            <!-- Main heading -->
            <h1
                class="fade-in delay-1 mt-5 max-w-5xl
                       font-serif text-5xl font-light leading-[0.95]
                       tracking-tight text-white
                       sm:text-6xl
                       md:text-7xl
                       lg:text-8xl
                       xl:text-[6.5rem]"
            >
                Paint with buttercream.
                <span class="block italic text-white/90">
                    Taste the art.
                </span>
            </h1>

            <!-- Supporting copy -->
            <p
                class="fade-in delay-2 mt-7 max-w-2xl
                       text-base leading-relaxed text-white/80
                       md:text-lg lg:text-xl"
            >
                A hands-on experience where food, creativity, culture,
                and gathering come together. Learn something new,
                make something beautiful, and enjoy the process.
            </p>

            <!-- CTAs -->
            <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                <a
                    href="/contact"
                    class="group inline-flex items-center justify-center
                           bg-warm-white px-7 py-4
                           text-sm font-medium uppercase
                           tracking-[0.14em] text-charcoal
                           transition-all duration-300
                           hover:-translate-y-0.5
                           hover:bg-white hover:shadow-xl"
                >
                    <span>Register for a Class</span>

                    <span
                        class="ml-4 transition-transform duration-300
                               group-hover:translate-x-1"
                    >
                        →
                    </span>
                </a>

                <a
                    href="/events"
                    class="group inline-flex items-center gap-3
                           px-2 py-4
                           text-sm uppercase
                           tracking-[0.14em] text-white/90"
                >
                    <span>See Upcoming Workshops</span>

                    <span
                        class="h-px w-8 bg-white/50
                               transition-all duration-300
                               group-hover:w-12 group-hover:bg-white"
                    ></span>
                </a>
            </div>

            <!-- Small supporting statement -->
            <div
                class="fade-in delay-4 mt-10 flex items-center gap-3
                       text-sm text-white/65"
            >
                <span class="text-lg text-white/80">✦</span>
                <span>Come curious. Leave with something you made.</span>
            </div>

        </div>
    </div>

    <!-- Scroll cue -->
    <div
        class="absolute bottom-7 right-6 z-10 hidden
               items-center gap-3
               text-[10px] uppercase
               tracking-[0.25em] text-white/60
               sm:flex md:right-12
               lg:right-20 xl:right-32"
    >
        <span>Explore TEAL</span>
        <span class="h-10 w-px bg-white/30"></span>
    </div>
</section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center">
                    <p class="section-label fade-in">What is TEAL?</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Creativity meets culture. Hands-on meets meaningful.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <article class="fade-in border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🎨</div>
                        <h3 class="font-serif text-2xl text-charcoal">Creative expression</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            No experience needed. Work with your hands, play with color, and create something uniquely yours in a supportive community.
                        </p>
                    </article>

                    <article class="fade-in delay-1 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">📚</div>
                        <h3 class="font-serif text-2xl text-charcoal">Cultural learning</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Each experience tells a story. Learn about art history, cultural traditions, and the ideas behind the makers we celebrate.
                        </p>
                    </article>

                    <article class="fade-in delay-2 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🍰</div>
                        <h3 class="font-serif text-2xl text-charcoal">Delicious results</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Create art you can admire, photograph, share, and eat. Every piece is temporary — and that's the beauty.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-2">
                    <div>
                        <p class="section-label fade-in">Current workshop</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Edible Monet — Now booking
                        </h2>
                        <div class="mt-6 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Begin your TEAL journey with Edible Monet, an intimate hands-on experience inspired by Claude Monet and the beauty of Impressionism.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-6">
                        <div class="fade-in border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">The experience</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Explore Impressionism</h3>
                            <p class="mt-3 text-stone leading-relaxed">Learn about Monet's life, his famous gardens at Giverny, and the revolutionary ideas behind Impressionist art over tea.</p>
                        </div>
                        <div class="fade-in delay-1 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Hands-on creation</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Paint with buttercream</h3>
                            <p class="mt-3 text-stone leading-relaxed">Using palette knives and garden-inspired colors, create your own Impressionist-inspired edible artwork under gentle guidance.</p>
                        </div>
                        <div class="fade-in delay-2 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Take it home</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Your creation</h3>
                            <p class="mt-3 text-stone leading-relaxed">Admire it, photograph it, share it, and taste it. Your edible art is yours to enjoy and celebrate.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">What's included</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Everything you need for a complete experience.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    <div class="fade-in bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🎓</div>
                        <h3 class="font-serif text-xl text-charcoal">Art history lesson</h3>
                        <p class="mt-2 text-sm text-stone">Engaging introduction to the artist and artistic movement</p>
                    </div>
                    <div class="fade-in delay-1 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🛠️</div>
                        <h3 class="font-serif text-xl text-charcoal">All materials included</h3>
                        <p class="mt-2 text-sm text-stone">Edible canvas, buttercream, palette knives, and all tools</p>
                    </div>
                    <div class="fade-in delay-2 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🫖</div>
                        <h3 class="font-serif text-xl text-charcoal">Tea & refreshments</h3>
                        <p class="mt-2 text-sm text-stone">Premium tea selection and tea-party snacks included</p>
                    </div>
                    <div class="fade-in delay-3 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">👨‍🏫</div>
                        <h3 class="font-serif text-xl text-charcoal">Guided instruction</h3>
                        <p class="mt-2 text-sm text-stone">Hands-on teaching from our edible arts facilitators</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
                    <div class="overflow-hidden rounded-sm">
                        <img src="/media/img/collage-3_4.webp" alt="Edible arts in progress" class="h-full w-full object-cover" />
                    </div>

                    <div>
                        <p class="section-label fade-in">Who is this for?</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Curious, creative people of all experience levels.
                        </h2>
                        <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                            You don't need to know how to paint. You don't need cake-decorating experience. You only need a willingness to experiment, play with color, and stay present with what's happening in front of you.
                        </p>
                        <ul class="mt-8 space-y-4 text-stone">
                            <li class="flex gap-3"><span class="text-sage">◈</span> Solo attendance welcome — meet creative friends</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Perfect for friends, mothers and daughters, creative partners</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> All ages and experience levels celebrated</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">The philosophy</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Creativity doesn't need to be permanent to be meaningful.
                    </h2>
                    <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                        We spend so much of our lives trying to make things perfect. TEAL invites something different: work with your hands, notice texture and color, stay present. And because the artwork is temporary, there's freedom in it. You can admire it. Photograph it. Share it. Eat it. And then create again. Sometimes the experience itself is the art.
                    </p>
                </div>
            </div>
        </section>

        <section class="relative overflow-hidden py-32 md:py-40 text-center text-white">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/AG1_4.jpg" alt="TEAL workshop gathering" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <p class="section-label text-white/80 fade-in">Ready to create?</p>
                <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                    Join us for an edible arts experience.
                </h2>
                <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                    A table. A few colors. Something delicious. Permission to make.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="/contact" class="btn-primary">Register for a Class</a>
                    <a href="/events" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">See Upcoming Workshops</a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
<style>
.fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: fadeInHero 0.7s ease forwards;
}

.fade-in.delay-1 {
    animation-delay: 0.08s;
}

.fade-in.delay-2 {
    animation-delay: 0.16s;
}

.fade-in.delay-3 {
    animation-delay: 0.24s;
}

@keyframes fadeInHero {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .fade-in {
        opacity: 1;
        transform: none;
        animation: none;
    }
}
</style>