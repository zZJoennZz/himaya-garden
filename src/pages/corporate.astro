---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Corporate Gatherings at Himaya Garden | Tucson"
    description="Host team retreats, offsites, workshops, and meaningful corporate gatherings at Himaya Garden in Tucson. Thoughtful hospitality, flexible spaces, and a beautiful desert setting."
>
    <main>

        <!-- =========================================================
             HERO
        ========================================================== -->
        <section class="relative isolate min-h-[92svh] overflow-hidden bg-warm-white text-charcoal">

            <!-- Background image -->
            <div class="absolute inset-0 opacity-40">
                <img
                    src="/media/img/gallery/levitate shot of food catering.jpeg"
                    alt="Corporate gathering in the garden"
                    class="h-full w-full object-cover object-center"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                />
            </div>

            <!-- Cinematic overlays -->
            <div class="absolute inset-0 bg-white/10"></div>

            <div
                class="absolute inset-0 bg-gradient-to-r
                       from-white/40 via-white/20 to-transparent"
            ></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/30 via-white/5 to-transparent"
            ></div>

            <!-- Subtle texture -->
            <div
                class="absolute inset-0 opacity-[0.045]"
                style="
                    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
                    background-size: 30px 30px;
                "
            ></div>

            <!-- Hero content -->
            <div
                class="relative z-10 flex min-h-[92svh] items-end
                       mx-auto max-w-7xl
                       px-6 pb-16 pt-32
                       md:px-12 md:pb-20
                       lg:px-20 lg:pb-24
                       xl:px-32"
            >
                <div class="max-w-5xl">

                    <div
                        class="fade-in flex items-center gap-3
                               text-xs font-medium uppercase
                               tracking-[0.28em] text-sage
                               md:text-sm"
                    >
                        <span class="h-px w-10 bg-sage/60"></span>
                        Corporate gatherings
                    </div>

                    <h1
                        class="fade-in delay-1 mt-5 max-w-5xl
                               font-serif text-5xl font-light leading-[0.95]
                               tracking-tight text-charcoal
                               sm:text-6xl
                               md:text-7xl
                               lg:text-8xl
                               xl:text-[7rem]"
                    >
                        Gather your team
                        <span class="block italic text-charcoal/80">
                            in a setting that feels intentional.
                        </span>
                    </h1>

                    <p
                        class="fade-in delay-2 mt-7 max-w-2xl
                               text-base leading-relaxed text-charcoal/75
                               md:text-lg lg:text-xl"
                    >
                        From leadership retreats and team offsites to product
                        launches and thoughtful client events, Himaya Garden
                        gives your organization a beautiful place to connect,
                        create, and reset.
                    </p>

                    <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                        <a
                            href="/contact"
                            class="group inline-flex items-center justify-center
                                   bg-sage px-7 py-4
                                   text-sm font-medium uppercase
                                   tracking-[0.14em] text-warm-white
                                   transition-all duration-300
                                   hover:-translate-y-0.5
                                   hover:bg-sage-dark hover:shadow-xl"
                        >
                            <span>Book a Corporate Tour</span>
                            <span
                                class="ml-4 transition-transform duration-300
                                       group-hover:translate-x-1"
                            >
                                →
                            </span>
                        </a>

                        <a
                            href="/events"
                            class="group inline-flex items-center gap-3
                                   px-2 py-4
                                   text-sm uppercase tracking-[0.14em]
                                   text-sage"
                        >
                            <span>Explore Upcoming Experiences</span>
                            <span
                                class="h-px w-8 bg-sage/50
                                       transition-all duration-300
                                       group-hover:w-12 group-hover:bg-sage"
                            ></span>
                        </a>
                    </div>

                    <!-- Corporate snapshot -->
                    <div
                        class="fade-in delay-4 mt-10 flex flex-wrap
                               items-center gap-x-7 gap-y-3
                               text-sm text-stone"
                    >
                        <span>4.9 guest experience rating</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>200 flexible capacity</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>Tailored planning support</span>
                    </div>
                </div>
            </div>

            <!-- Scroll cue -->
            <div
                class="absolute bottom-7 right-6 z-10 hidden
                       items-center gap-3
                       text-[10px] uppercase tracking-[0.25em]
                       text-charcoal/50
                       sm:flex md:right-12
                       lg:right-20 xl:right-32"
            >
                <span>Explore the garden</span>
                <span class="h-10 w-px bg-charcoal/20"></span>
            </div>
        </section>


        <!-- =========================================================
             WHY TEAMS CHOOSE HIMAYA
        ========================================================== -->
        <section class="relative overflow-hidden bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="pointer-events-none absolute left-0 top-0
                       h-64 w-64 -translate-x-1/2 -translate-y-1/2
                       rounded-full border border-sage/10"
            ></div>

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >
                <div class="mx-auto max-w-4xl text-center">

                    <p class="section-label fade-in">
                        Why teams choose Himaya
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        A space that supports focus, warmth, and meaningful connection.
                    </h2>

                </div>


                <div class="mt-14 grid gap-5 lg:grid-cols-3">

                    <article
                        class="fade-in group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🌿
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                A calming environment
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                The garden gives your team room to breathe.
                                It feels elevated, welcoming, and far removed
                                from the usual conference-room atmosphere.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🤝
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Built for togetherness
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                Whether it is a strategic workshop, leadership
                                gathering, or a casual team lunch, the setting
                                invites connection without feeling crowded or
                                transactional.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🍽️
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Thoughtful hospitality
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                We curate the experience around your goals,
                                from the flow of the day to the menu, ensuring
                                guests feel cared for from arrival to farewell.
                            </p>
                        </div>
                    </article>

                </div>
            </div>
        </section>


        <!-- =========================================================
             CORPORATE EXPERIENCES
        ========================================================== -->
        <section class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr]">

                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Corporate experiences
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            Flexible formats for thoughtful business gatherings.
                        </h2>

                        <div class="fade-in delay-2 mt-7 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Himaya Garden is ideal for organizations seeking
                                a venue that feels distinctive, calm, and polished
                                without sacrificing practicality.
                            </p>
                            <p>
                                We support a wide range of corporate uses, from
                                intimate leadership meetings and workshop days
                                to larger team retreats and celebratory client
                                gatherings.
                            </p>
                        </div>

                    </div>


                    <!-- Experience cards -->
                    <div class="grid gap-5">

                        <div
                            class="fade-in relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Team retreats
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    01
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Reset the room and the energy.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Create a retreat that balances planning,
                                reflection, and connection in a naturally
                                restorative environment.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-1 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Offsites & planning days
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    02
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                A setting that supports focus.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Move beyond standard workspaces with a venue
                                designed to help ideas land with clarity and
                                ease.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-2 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Client events & launches
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    03
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Make a memorable first impression.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Impress guests with warm hospitality, layered
                                garden spaces, and a culinary experience they
                                will remember.
                            </p>
                        </div>

                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             THE VENUE
        ========================================================== -->
        <section class="bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        The venue
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        A garden setting that feels elevated without ever feeling rigid.
                    </h2>

                </div>


                <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                    <div
                        class="fade-in group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            🌤️
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Warm natural light
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            Perfect for daytime sessions and sunset gatherings.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-1 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            🌿
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Botanical elegance
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            A lush backdrop that gives your team and guests a
                            memorable first impression.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-2 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            🧭
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Flexible layout
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            From workshop seating to reception tables, the
                            venue adapts to your event flow.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-3 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            📍
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Midtown Tucson
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            Easy access for teams, clients, and visiting guests.
                        </p>
                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             CULINARY EXPERIENCE
        ========================================================== -->
        <section class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">

                    <!-- Image -->
                    <div
                        class="fade-in relative overflow-hidden rounded-sm
                               shadow-xl"
                    >
                        <img
                            src="/media/img/high tea two women eating at the table.jpeg"
                            alt="Corporate lunch in the garden"
                            class="aspect-[4/3] h-full w-full object-cover
                                   transition-transform duration-700
                                   hover:scale-[1.03]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/20 to-transparent"
                        ></div>
                    </div>


                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Culinary experience
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            Food that helps people linger longer and connect deeper.
                        </h2>

                        <p
                            class="fade-in delay-2 mt-6
                                   text-lg leading-relaxed text-stone"
                        >
                            We believe hospitality is part of the strategy.
                            Our menus are designed to feel generous, thoughtful,
                            and memorable — inspired by Filipino heritage and
                            adapted for modern gatherings.
                        </p>

                        <ul class="fade-in delay-3 mt-8 space-y-4 text-stone">

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Seasonal menu planning tailored to your event</span>
                            </li>

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Elegant tea service, light bites, and full dining options</span>
                            </li>

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Hospitality that supports both formal and relaxed formats</span>
                            </li>

                        </ul>

                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             OUR PROCESS
        ========================================================== -->
        <section class="bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        Our process
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        Straightforward planning from first conversation to final detail.
                    </h2>

                </div>


                <div class="mt-14 grid gap-5 sm:grid-cols-3">

                    <div
                        class="fade-in group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 font-serif text-4xl text-sage
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            01
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Discovery
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            We learn about your goals, guest count, timeline,
                            and the kind of experience you want to create.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-1 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 font-serif text-4xl text-sage
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            02
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Design
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            We shape the flow, menu, and atmosphere around
                            your event so it feels purposeful and seamless.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-2 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 font-serif text-4xl text-sage
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            03
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Host
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            On the day, we help create a welcoming experience
                            your team and guests can simply enjoy.
                        </p>
                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             CTA / BUILD YOUR CORPORATE EXPERIENCE
        ========================================================== -->
        <section class="relative isolate overflow-hidden bg-warm-white py-32 md:py-40">

            <!-- Background -->
            <div class="absolute inset-0">

                <img
                    src="/media/img/AG1_4.jpg"
                    alt="Corporate event at Himaya Garden"
                    class="h-full w-full object-cover opacity-30"
                    loading="lazy"
                />

            </div>

            <div class="absolute inset-0 bg-white/60"></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/40 via-white/10 to-white/20"
            ></div>


            <!-- Content -->
            <div
                class="relative z-10 mx-auto max-w-4xl
                       px-6 text-center text-charcoal
                       md:px-12 lg:px-20 xl:px-32"
            >

                <p class="section-label text-sage fade-in">
                    Build your corporate experience
                </p>

                <h2
                    class="fade-in mt-4
                           font-serif text-4xl font-light
                           leading-tight
                           sm:text-5xl
                           md:text-6xl"
                >
                    Ready to host something meaningful for your team?
                </h2>

                <p
                    class="fade-in delay-1 mx-auto mt-6 max-w-2xl
                           text-lg leading-relaxed text-charcoal/75
                           md:text-xl"
                >
                    Tell us what you are planning and we will help shape a
                    corporate experience that feels beautiful, grounded, and
                    memorable.
                </p>

                <div
                    class="fade-in delay-2 mt-9
                           flex flex-wrap justify-center gap-4"
                >

                    <a
                        href="/contact"
                        class="group inline-flex items-center justify-center
                               bg-sage px-7 py-4
                               text-sm font-medium uppercase
                               tracking-[0.14em] text-warm-white
                               transition-all duration-300
                               hover:-translate-y-0.5
                               hover:bg-sage-dark hover:shadow-xl"
                    >
                        <span>Book a Corporate Tour</span>

                        <span
                            class="ml-4 transition-transform duration-300
                                   group-hover:translate-x-1"
                        >
                            →
                        </span>
                    </a>

                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center
                               border border-sage/40
                               px-7 py-4
                               text-sm font-medium uppercase
                               tracking-[0.14em] text-sage
                               transition-all duration-300
                               hover:bg-sage hover:text-white"
                    >
                        Inquire About Corporate Events
                    </a>

                </div>

            </div>
        </section>

        <!-- Mobile CTA -->
        <div
