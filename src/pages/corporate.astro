---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Corporate Gatherings at Himaya Garden | Tucson"
    description="Host team retreats, offsites, workshops, and meaningful corporate gatherings at Himaya Garden in Tucson. Thoughtful hospitality, flexible spaces, and a beautiful desert setting."
>
    <main>
        <section class="relative overflow-hidden bg-cream pt-32 pb-20 md:pt-40 md:pb-28">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(132,147,118,0.18),_transparent_58%)]"></div>
            <div class="relative mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
                    <div>
                        <p class="section-label fade-in">Corporate gatherings</p>
                        <h1 class="fade-in delay-1 font-serif text-5xl md:text-6xl lg:text-7xl font-light leading-none text-charcoal">
                            Gather your team in a setting that feels intentional.
                        </h1>
                        <p class="fade-in delay-2 mt-6 max-w-xl text-lg leading-relaxed text-stone">
                            From leadership retreats and team offsites to product launches and thoughtful client events, Himaya Garden gives your organization a beautiful place to connect, create, and reset.
                        </p>
                        <div class="fade-in delay-3 mt-8 flex flex-wrap gap-4">
                            <a href="/contact" class="btn-primary">Book a Corporate Tour</a>
                            <a href="/events" class="btn-secondary">Explore Upcoming Experiences</a>
                        </div>
                        <div class="fade-in delay-4 mt-10 flex flex-wrap gap-8 text-sm text-charcoal">
                            <div>
                                <div class="font-serif text-3xl text-sage">4.9</div>
                                <div class="mt-1 text-stone">Guest experience rating</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">200</div>
                                <div class="mt-1 text-stone">Flexible guest capacity</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">Tailored</div>
                                <div class="mt-1 text-stone">Planning support</div>
                            </div>
                        </div>
                    </div>

                    <div class="fade-in delay-2 overflow-hidden rounded-sm shadow-lg">
                        <img src="/media/img/hero-image.webp" alt="Corporate gathering in the garden" class="h-full w-full object-cover" />
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center">
                    <p class="section-label fade-in">Why teams choose Himaya</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        A space that supports focus, warmth, and meaningful connection.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <article class="fade-in border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl text-sage">🌿</div>
                        <h3 class="font-serif text-2xl text-charcoal">A calming environment</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            The garden gives your team room to breathe. It feels elevated, welcoming, and far removed from the usual conference-room atmosphere.
                        </p>
                    </article>

                    <article class="fade-in delay-1 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl text-sage">🤝</div>
                        <h3 class="font-serif text-2xl text-charcoal">Built for togetherness</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Whether it is a strategic workshop, leadership gathering, or a casual team lunch, the setting invites connection without feeling crowded or transactional.
                        </p>
                    </article>

                    <article class="fade-in delay-2 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl text-sage">🍽️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Thoughtful hospitality</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            We curate the experience around your goals, from the flow of the day to the menu, ensuring guests feel cared for from arrival to farewell.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-2">
                    <div>
                        <p class="section-label fade-in">Corporate experiences</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Flexible formats for thoughtful business gatherings.
                        </h2>
                        <div class="mt-6 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Himaya Garden is ideal for organizations seeking a venue that feels distinctive, calm, and polished without sacrificing practicality.
                            </p>
                            <p>
                                We support a wide range of corporate uses, from intimate leadership meetings and workshop days to larger team retreats and celebratory client gatherings.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-6">
                        <div class="fade-in border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Team retreats</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Reset the room and the energy.</h3>
                            <p class="mt-3 text-stone leading-relaxed">Create a retreat that balances planning, reflection, and connection in a naturally restorative environment.</p>
                        </div>
                        <div class="fade-in delay-1 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Offsites & planning days</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">A setting that supports focus.</h3>
                            <p class="mt-3 text-stone leading-relaxed">Move beyond standard workspaces with a venue designed to help ideas land with clarity and ease.</p>
                        </div>
                        <div class="fade-in delay-2 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Client events & launches</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Make a memorable first impression.</h3>
                            <p class="mt-3 text-stone leading-relaxed">Impress guests with warm hospitality, layered garden spaces, and a culinary experience they will remember.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">The venue</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        A garden setting that feels elevated without ever feeling rigid.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    <div class="fade-in bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🌤️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Warm natural light</h3>
                        <p class="mt-2 text-stone leading-relaxed">Perfect for daytime sessions and sunset gatherings.</p>
                    </div>
                    <div class="fade-in delay-1 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🌿</div>
                        <h3 class="font-serif text-2xl text-charcoal">Botanical elegance</h3>
                        <p class="mt-2 text-stone leading-relaxed">A lush backdrop that gives your team and guests a memorable first impression.</p>
                    </div>
                    <div class="fade-in delay-2 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🧭</div>
                        <h3 class="font-serif text-2xl text-charcoal">Flexible layout</h3>
                        <p class="mt-2 text-stone leading-relaxed">From workshop seating to reception tables, the venue adapts to your event flow.</p>
                    </div>
                    <div class="fade-in delay-3 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">📍</div>
                        <h3 class="font-serif text-2xl text-charcoal">Midtown Tucson</h3>
                        <p class="mt-2 text-stone leading-relaxed">Easy access for teams, clients, and visiting guests.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
                    <div class="overflow-hidden rounded-sm">
                        <img src="/media/img/high tea two women eating at the table.jpeg" alt="Corporate lunch in the garden" class="h-full w-full object-cover" />
                    </div>

                    <div>
                        <p class="section-label fade-in">Culinary experience</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Food that helps people linger longer and connect deeper.
                        </h2>
                        <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                            We believe hospitality is part of the strategy. Our menus are designed to feel generous, thoughtful, and memorable — inspired by Filipino heritage and adapted for modern gatherings.
                        </p>
                        <ul class="mt-8 space-y-4 text-stone">
                            <li class="flex gap-3"><span class="text-sage">◈</span> Seasonal menu planning tailored to your event</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Elegant tea service, light bites, and full dining options</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Hospitality that supports both formal and relaxed formats</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-6xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">Our process</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Straightforward planning from first conversation to final detail.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <div class="fade-in rounded-sm border border-sage/10 bg-cream p-7">
                        <div class="mb-4 font-serif text-4xl text-sage">01</div>
                        <h3 class="font-serif text-2xl text-charcoal">Discovery</h3>
                        <p class="mt-3 text-stone leading-relaxed">We learn about your goals, guest count, timeline, and the kind of experience you want to create.</p>
                    </div>
                    <div class="fade-in delay-1 rounded-sm border border-sage/10 bg-cream p-7">
                        <div class="mb-4 font-serif text-4xl text-sage">02</div>
                        <h3 class="font-serif text-2xl text-charcoal">Design</h3>
                        <p class="mt-3 text-stone leading-relaxed">We shape the flow, menu, and atmosphere around your event so it feels purposeful and seamless.</p>
                    </div>
                    <div class="fade-in delay-2 rounded-sm border border-sage/10 bg-cream p-7">
                        <div class="mb-4 font-serif text-4xl text-sage">03</div>
                        <h3 class="font-serif text-2xl text-charcoal">Host</h3>
                        <p class="mt-3 text-stone leading-relaxed">On the day, we help create a welcoming experience your team and guests can simply enjoy.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative overflow-hidden py-32 md:py-40 text-center text-white">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/AG1_4.jpg" alt="Corporate event at Himaya Garden" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                    <p class="section-label text-white/80 fade-in">Build your corporate experience</p>
                    <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                        Ready to host something meaningful for your team?
                    </h2>
                    <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                        Tell us what you are planning and we will help shape a corporate experience that feels beautiful, grounded, and memorable.
                    </p>
                    <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                        <a href="/contact" class="btn-primary">Book a Corporate Tour</a>
                        <a href="/contact" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">Inquire About Corporate Events</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
