---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Catering & Food Services | Himaya Garden Tucson"
    description="Award-winning catering services in Tucson. Filipino heritage cuisine, custom menus, and full-service hospitality for events of all sizes."
>
    <main>
        <section class="relative overflow-hidden bg-cream pt-32 pb-20 md:pt-40 md:pb-28">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(132,147,118,0.18),_transparent_58%)]"></div>
            <div class="relative mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
                    <div>
                        <p class="section-label fade-in">Catering & food</p>
                        <h1 class="fade-in delay-1 font-serif text-5xl md:text-6xl lg:text-7xl font-light leading-none text-charcoal">
                            Food rooted in culture and care.
                        </h1>
                        <p class="fade-in delay-2 mt-6 max-w-xl text-lg leading-relaxed text-stone">
                            From heritage Filipino cuisine to contemporary menus, our full-service catering brings warmth, flavor, and thoughtful hospitality to every gathering. Celebrating ingredients, stories, and the joy of sharing meals together.
                        </p>
                        <div class="fade-in delay-3 mt-8 flex flex-wrap gap-4">
                            <a href="/contact" class="btn-primary">Inquire About Catering</a>
                            <a href="/contact" class="btn-secondary">Request Menu Samples</a>
                        </div>
                        <div class="fade-in delay-4 mt-10 flex flex-wrap gap-8 text-sm text-charcoal">
                            <div>
                                <div class="font-serif text-3xl text-sage">10-200+</div>
                                <div class="mt-1 text-stone">Guests capacity</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">Customized</div>
                                <div class="mt-1 text-stone">Menu creation</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">Full service</div>
                                <div class="mt-1 text-stone">Hospitality included</div>
                            </div>
                        </div>
                    </div>

                    <div class="fade-in delay-2 overflow-hidden rounded-sm shadow-lg">
                        <img src="/media/img/AG1_4.jpg" alt="Catered event spread" class="h-full w-full object-cover" />
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center">
                    <p class="section-label fade-in">Why choose Himaya catering</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Every meal tells a story.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <article class="fade-in border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🌿</div>
                        <h3 class="font-serif text-2xl text-charcoal">Heritage recipes</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Filipino cuisine rooted in family tradition. Recipes passed through generations, prepared with care and authentic ingredients.
                        </p>
                    </article>

                    <article class="fade-in delay-1 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🍽️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Customized menus</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            From themed multi-course experiences to casual gatherings. Every menu is designed around your vision, guests, and celebration.
                        </p>
                    </article>

                    <article class="fade-in delay-2 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">❤️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Thoughtful service</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Our team anticipates needs, creates beautiful presentations, and ensures your guests feel genuinely welcomed and cared for.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-2">
                    <div>
                        <p class="section-label fade-in">Menu options</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            From heritage to contemporary, from intimate to grand.
                        </h2>
                        <div class="mt-6 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Our culinary team works with you to create menus that reflect your event's spirit while honoring the flavors and stories that define our kitchen.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-6">
                        <div class="fade-in border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">🇵🇭 Filipino Heritage</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Authentic Tradition</h3>
                            <p class="mt-3 text-stone leading-relaxed">Cebuano specialties, family recipes, and dishes that celebrate our cultural roots and ancestors' legacy.</p>
                        </div>
                        <div class="fade-in delay-1 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">✨ Fusion & Contemporary</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Modern Creativity</h3>
                            <p class="mt-3 text-stone leading-relaxed">Blending heritage ingredients with contemporary techniques for fresh, exciting culinary experiences.</p>
                        </div>
                        <div class="fade-in delay-2 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">🌿 Seasonal & Local</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Market-Inspired</h3>
                            <p class="mt-3 text-stone leading-relaxed">Dishes built around seasonal ingredients and Arizona's vibrant local food producers and farmers.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">Catering services</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Everything you need for a seamless celebration.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    <div class="fade-in bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">📋</div>
                        <h3 class="font-serif text-xl text-charcoal">Menu consultation</h3>
                        <p class="mt-2 text-sm text-stone">Work with our team to design the perfect menu for your event</p>
                    </div>
                    <div class="fade-in delay-1 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🍽️</div>
                        <h3 class="font-serif text-xl text-charcoal">Full meal service</h3>
                        <p class="mt-2 text-sm text-stone">From plating to service staff, complete catering coordination</p>
                    </div>
                    <div class="fade-in delay-2 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🍰</div>
                        <h3 class="font-serif text-xl text-charcoal">Specialty items</h3>
                        <p class="mt-2 text-sm text-stone">Custom cakes, pastries, and sweet treats from Dragonfly Cakes</p>
                    </div>
                    <div class="fade-in delay-3 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🍷</div>
                        <h3 class="font-serif text-xl text-charcoal">Beverage selection</h3>
                        <p class="mt-2 text-sm text-stone">Tea, coffee, cocktails, and non-alcoholic options curated for your crowd</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
                    <div class="overflow-hidden rounded-sm">
                        <img src="/media/img/collage-3_4.webp" alt="Catering spread and service" class="h-full w-full object-cover" />
                    </div>

                    <div>
                        <p class="section-label fade-in">Special accommodations</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Every guest is thoughtfully served.
                        </h2>
                        <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                            Dietary restrictions, allergies, cultural preferences, and nutritional needs are all met with care and expertise. Our team works closely with you to ensure every guest feels welcomed at the table.
                        </p>
                        <ul class="mt-8 space-y-4 text-stone">
                            <li class="flex gap-3"><span class="text-sage">◈</span> Vegetarian, vegan, and plant-based options</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Gluten-free and allergen-aware preparation</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Cultural and religious dietary considerations</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">From Dragonfly Cakes</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Handcrafted desserts & cakes
                    </h2>
                    <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                        Completing your catering with beautiful, delicious custom desserts. Wedding cakes, celebration cakes, pastries, and treats that look as good as they taste.
                    </p>
                    <div class="fade-in delay-3 mt-8">
                        <a href="/contact" class="btn-primary">Discuss Your Dessert</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative overflow-hidden py-32 md:py-40 text-center text-white">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/AG1_4.jpg" alt="Catered celebration" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <p class="section-label text-white/80 fade-in">Ready to book catering?</p>
                <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                    Let's create a menu for your celebration.
                </h2>
                <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                    Connect with our culinary team to explore menus, pricing, and full catering services for your event.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="/contact" class="btn-primary">Inquire About Catering</a>
                    <a href="/contact" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">Request Menu Samples</a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
