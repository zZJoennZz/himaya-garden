---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Wedding Venue in Tucson | Himaya Garden"
    description="Beautiful garden wedding venue in Tucson, Arizona. Intimate ceremonies, elegant receptions, and Filipino-inspired catering for meaningful celebrations."
>
    <main>
        <section class="relative overflow-hidden bg-cream pt-32 pb-20 md:pt-40 md:pb-28">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(132,147,118,0.18),_transparent_58%)]"></div>
            <div class="relative mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
                    <div>
                        <p class="section-label fade-in">Wedding celebrations</p>
                        <h1 class="fade-in delay-1 font-serif text-5xl md:text-6xl lg:text-7xl font-light leading-none text-charcoal">
                            Your wedding in a garden that feels sacred.
                        </h1>
                        <p class="fade-in delay-2 mt-6 max-w-xl text-lg leading-relaxed text-stone">
                            A Tucson venue designed for intimate ceremonies, joyful celebrations, and the kind of hospitality that makes your guests feel genuinely welcomed. From dawn to dusk, the garden becomes the backdrop for your unique love story.
                        </p>
                        <div class="fade-in delay-3 mt-8 flex flex-wrap gap-4">
                            <a href="/contact" class="btn-primary">Schedule a Wedding Consultation</a>
                            <a href="/events" class="btn-secondary">View Upcoming Celebrations</a>
                        </div>
                        <div class="fade-in delay-4 mt-10 flex flex-wrap gap-8 text-sm text-charcoal">
                            <div>
                                <div class="font-serif text-3xl text-sage">120</div>
                                <div class="mt-1 text-stone">Seated capacity</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">4.9</div>
                                <div class="mt-1 text-stone">Guest satisfaction</div>
                            </div>
                            <div>
                                <div class="font-serif text-3xl text-sage">Full</div>
                                <div class="mt-1 text-stone">Catering available</div>
                            </div>
                        </div>
                    </div>

                    <div class="fade-in delay-2 overflow-hidden rounded-sm shadow-lg">
                        <img src="/media/img/hero-image.webp" alt="Wedding ceremony in Himaya Garden" class="h-full w-full object-cover" />
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center">
                    <p class="section-label fade-in">Why couples choose Himaya</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        A venue that feels personal, not corporate.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-3">
                    <article class="fade-in border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">💍</div>
                        <h3 class="font-serif text-2xl text-charcoal">Naturally photogenic</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Every angle tells a story. The garden is your backdrop — no extra décor needed, though we welcome yours.
                        </p>
                    </article>

                    <article class="fade-in delay-1 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🌿</div>
                        <h3 class="font-serif text-2xl text-charcoal">Meaningful ceremony spaces</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Layered garden settings for intimate vows and flexible room for your unique rituals and traditions.
                        </p>
                    </article>

                    <article class="fade-in delay-2 border border-sage/10 bg-cream p-7 rounded-sm">
                        <div class="mb-4 text-3xl">🍽️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Culinary heritage</h3>
                        <p class="mt-3 text-stone leading-relaxed">
                            Filipino-inspired menus rooted in family tradition, or fully custom menus shaped around your vision.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid items-center gap-12 lg:grid-cols-2">
                    <div>
                        <p class="section-label fade-in">Your ceremony</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            From vows to reception, a flow that feels intentional.
                        </h2>
                        <div class="mt-6 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                We believe your wedding should reflect who you are — your values, your traditions, your joy.
                            </p>
                            <p>
                                Our team works closely with you to design every moment: the ceremony setting, the processional, the gathering spaces, the dining experience. We handle the logistics so you can be present for the magic.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-6">
                        <div class="fade-in border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Ceremony</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Sacred space for your vows</h3>
                            <p class="mt-3 text-stone leading-relaxed">Intimate settings among greenery, with flexible configurations for your ceremony style.</p>
                        </div>
                        <div class="fade-in delay-1 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Reception</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">Celebration and connection</h3>
                            <p class="mt-3 text-stone leading-relaxed">Multiple garden spaces for cocktails, dining, dancing, and moments of quiet togetherness.</p>
                        </div>
                        <div class="fade-in delay-2 border border-sage/10 bg-warm-white p-6 rounded-sm">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage">Sunset magic</p>
                            <h3 class="mt-3 font-serif text-2xl text-charcoal">That golden desert light</h3>
                            <p class="mt-3 text-stone leading-relaxed">The garden transforms during golden hour — no extra lighting needed, just pure Tucson beauty.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-warm-white py-20 md:py-24">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="section-label fade-in">The details</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">
                        Everything you need to say yes.
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    <div class="fade-in bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">⏰</div>
                        <h3 class="font-serif text-2xl text-charcoal">Timing</h3>
                        <p class="mt-2 text-stone leading-relaxed">Ceremony at 4pm, reception until sunset. Flexible for your vision.</p>
                    </div>
                    <div class="fade-in delay-1 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🚗</div>
                        <h3 class="font-serif text-2xl text-charcoal">Parking</h3>
                        <p class="mt-2 text-stone leading-relaxed">On-site parking complimentary for all guests.</p>
                    </div>
                    <div class="fade-in delay-2 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">🍽️</div>
                        <h3 class="font-serif text-2xl text-charcoal">Catering</h3>
                        <p class="mt-2 text-stone leading-relaxed">In-house catering or approved outside vendors welcome.</p>
                    </div>
                    <div class="fade-in delay-3 bg-cream border border-sage/10 p-6 rounded-sm">
                        <div class="text-2xl mb-3">📸</div>
                        <h3 class="font-serif text-2xl text-charcoal">Photography</h3>
                        <p class="mt-2 text-stone leading-relaxed">Multiple backdrops and lighting throughout the day.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-cream py-24 md:py-32">
            <div class="mx-auto max-w-7xl px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
                    <div class="overflow-hidden rounded-sm">
                        <img src="/media/img/high tea two women eating at the table.jpeg" alt="Wedding reception meal at Himaya Garden" class="h-full w-full object-cover" />
                    </div>

                    <div>
                        <p class="section-label fade-in">Your feast</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal">
                            Food that makes your guests linger.
                        </h2>
                        <p class="fade-in delay-2 mt-6 text-lg leading-relaxed text-stone">
                            Your wedding menu is part of your story. We create menus rooted in Filipino heritage yet fully customizable to your tastes, dietary needs, and vision.
                        </p>
                        <ul class="mt-8 space-y-4 text-stone">
                            <li class="flex gap-3"><span class="text-sage">◈</span> Heritage-inspired or fully custom menus</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Cocktail hour through dessert service</li>
                            <li class="flex gap-3"><span class="text-sage">◈</span> Thoughtful wine and beverage pairings</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative overflow-hidden py-32 md:py-40 text-center text-white">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/AG1_4.jpg" alt="Wedding celebration at Himaya Garden" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <p class="section-label text-white/80 fade-in">Ready to say yes?</p>
                <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                    Let's plan a wedding that feels like home.
                </h2>
                <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                    Connect with us to explore availability, walk the garden, and begin shaping your wedding vision.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="/contact" class="btn-primary">Schedule a Wedding Tour</a>
                    <a href="/contact" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">Request Pricing</a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
