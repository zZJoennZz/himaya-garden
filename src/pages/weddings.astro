---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Wedding Venue in Tucson | Himaya Garden"
    description="One garden. One team. One quietly run day. The Signature Garden Wedding Experience — an all-inclusive Tucson wedding venue for couples who want to be present, not project managers."
>
    <main>

        <!-- =========================================================
             HERO
        ========================================================== -->
        <section class="relative isolate min-h-[92svh] overflow-hidden bg-warm-white text-charcoal">

            <!-- Background image -->
            <div class="absolute inset-0 opacity-40">
                <img
                    src="/media/img/hero-image.webp"
                    alt="Wedding ceremony in Himaya Garden"
                    class="h-full w-full object-cover object-center"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                />
            </div>

            <!-- Cinematic overlays -->
            <div class="absolute inset-0 bg-white/10"></div>

            <div
                class="absolute inset-0 bg-gradient-to-r
                       from-white/40 via-white/20 to-transparent"
            ></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/30 via-white/5 to-transparent"
            ></div>

            <!-- Subtle texture -->
            <div
                class="absolute inset-0 opacity-[0.045]"
                style="
                    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
                    background-size: 30px 30px;
                "
            ></div>

            <!-- Hero content -->
            <div
                class="relative z-10 flex min-h-[92svh] items-end
                       mx-auto max-w-7xl
                       px-6 pb-16 pt-32
                       md:px-12 md:pb-20
                       lg:px-20 lg:pb-24
                       xl:px-32"
            >
                <div class="max-w-5xl">

                    <div
                        class="fade-in flex items-center gap-3
                               text-xs font-medium uppercase
                               tracking-[0.28em] text-sage
                               md:text-sm"
                    >
                        <span class="h-px w-10 bg-sage/60"></span>
                        Introducing the Signature Garden Wedding Experience
                    </div>

                    <h1
                        class="fade-in delay-1 mt-5 max-w-5xl
                               font-serif text-5xl font-light leading-[0.95]
                               tracking-tight text-charcoal
                               sm:text-6xl
                               md:text-7xl
                               lg:text-8xl
                               xl:text-[7rem]"
                    >
                        From first look
                        <span class="block italic text-charcoal/80">
                            to last dance— handled.
                        </span>
                    </h1>

                    <p
                        class="fade-in delay-2 mt-7 max-w-2xl
                               text-base leading-relaxed text-charcoal/75
                               md:text-lg lg:text-xl"
                    >
                        One garden. One package. One team.
                    </p>

                    <p
                        class="fade-in delay-3 mt-4 max-w-2xl
                               text-base leading-relaxed text-charcoal/75
                               md:text-lg"
                    >
                        See what's included for your special day ↓
                    </p>

                    <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                        <a
                            href="/contact"
                            class="group inline-flex items-center justify-center
                                   bg-sage px-7 py-4
                                   text-sm font-medium uppercase
                                   tracking-[0.14em] text-warm-white
                                   transition-all duration-300
                                   hover:-translate-y-0.5
                                   hover:bg-sage-dark hover:shadow-xl"
                        >
                            <span>Book a Tour</span>
                            <span
                                class="ml-4 transition-transform duration-300
                                       group-hover:translate-x-1"
                            >
                                →
                            </span>
                        </a>

                        <a
                            href="#intro"
                            class="group inline-flex items-center gap-3
                                   px-2 py-4
                                   text-sm uppercase tracking-[0.14em]
                                   text-sage"
                        >
                            <span>See what's included</span>
                            <span
                                class="h-px w-8 bg-sage/50
                                       transition-all duration-300
                                       group-hover:w-12 group-hover:bg-sage"
                            ></span>
                        </a>
                    </div>

                    <!-- Venue snapshot -->
                    <div
                        class="fade-in delay-4 mt-10 flex flex-wrap
                               items-center gap-x-7 gap-y-3
                               text-sm text-stone"
                    >
                        <span>11 hours exclusive access</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>50 - 150 guests</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>One contract, one team</span>
                    </div>
                </div>
            </div>

            <!-- Scroll cue -->
            <div
                class="absolute bottom-7 right-6 z-10 hidden
                       items-center gap-3
                       text-[10px] uppercase tracking-[0.25em]
                       text-charcoal/50
                       sm:flex md:right-12
                       lg:right-20 xl:right-32"
            >
                <span>Walk the garden</span>
                <span class="h-10 w-px bg-charcoal/20"></span>
            </div>
        </section>


        <!-- =========================================================
             INTRO / POSITIONING
        ========================================================== -->
        <section class="relative overflow-hidden bg-warm-white py-20 md:py-24 lg:py-28" id="intro">

            <div
                class="pointer-events-none absolute left-0 top-0
                       h-64 w-64 -translate-x-1/2 -translate-y-1/2
                       rounded-full border border-sage/10"
            ></div>

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >
                <div class="mx-auto max-w-4xl text-center">

                    <p class="section-label fade-in">
                        A new way to host a wedding
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        You want a wedding. Not a part-time job.
                    </h2>

                    <p
                        class="fade-in delay-2 mx-auto mt-6 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        Most couples don't actually want freedom to choose every vendor. They want a beautiful outdoor setting, guests fed and happy, and zero "who's on what?" chaos on the day.
                    </p>

                </div>


                <div class="mt-14 grid items-start gap-5 lg:grid-cols-3">

                    <article
                        class="fade-in group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                💍
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                One package
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                Venue, food, BYO bar, DJ, cake, staff, setup and
                                teardown — gathered into a single contract.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🌿
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                One plan
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                A 30-day layout and timeline session that locks
                                every piece in place before the day arrives.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🍽️
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                One team
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                A single point of contact coordinates the moving
                                parts so you don't have to.
                            </p>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- =========================================================
             WEDDING GALLERY
        ========================================================== -->
        <section class="bg-warm-white pb-24 pt-4 md:pb-32 lg:pb-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div
                    class="grid gap-5
                           lg:grid-cols-[1.15fr_1fr_1fr]"
                >

                    <!-- Tall image -->
                    <figure
                        class="fade-in group relative overflow-hidden
                               rounded-sm shadow-lg lg:row-span-1"
                    >
                        <img
                            src="/media/img/love-couple.jpg"
                            alt="A wedding celebration in the Himaya Garden"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>


                    <!-- Shorter image -->
                    <figure
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm shadow-lg"
                    >
                        <img
                            src="/media/img/collage-2.jpg"
                            alt="The ceremony lawn at Himaya Garden"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>


                    <!-- Shorter image -->
                    <figure
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm shadow-lg"
                    >
                        <img
                            src="/media/img/event-weddings-2.jpg"
                            alt="Guests at a Himaya Garden celebration"
                            class="h-72 w-full object-cover
                                   transition-transform duration-700
                                   group-hover:scale-[1.04]
                                   sm:h-96 lg:h-[26rem]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/25 to-transparent"
                        ></div>
                    </figure>

                </div>
            </div>
        </section>

        <!-- =========================================================
             CEREMONY / RECEPTION STORY
        ========================================================== -->
        <section class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-start gap-14 lg:grid-cols-[0.95fr_1.05fr]">

                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Picture the day
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            You don't check a single timeline.
                            You walk a day already built for you.
                        </h2>

                        <div class="fade-in delay-2 mt-7 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                Eleven hours of exclusive garden access. No
                                flipping rooms in thirty minutes. No "where is
                                the DJ?" panic. Just a day that arrives already
                                in motion.
                            </p>
                        </div>

                    </div>


                    <!-- Experience cards -->
                    <div class="grid gap-5">

                        <div
                            class="fade-in relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Morning
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    01
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You wake up
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Your biggest decision is the playlist while you
                                get ready. The garden is already being set.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-1 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Arrival
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    02
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You step into a furnished garden
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Chairs are placed for ceremony. Tables, linens,
                                place settings, and glassware are in their places.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-2 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Ceremony
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    03
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                First look. Then vows.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Microphones are tested. The aisle is dressed.
                                Yard games are out for guests between moments.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-3 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Cocktails
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    04
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Bar is open
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Your alcohol — chilled, stocked, staffed. Iced
                                tea and lemonade for guests who want a quiet glass.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-4 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Reception
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    05
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Buffet served, warm and waiting
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Brunch or dinner. Two-tier display cake on the
                                table. Sheet cake and petit fours plated for the room.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-4 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Last dance
                                </p>

                                <!-- <span class="text-sm text-gold font-semibold">
                                    06
                                </span> -->
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                You don't move a single chair
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                The DJ closes the night. Our team handles teardown.
                                You walk out into the night, fully held.
                            </p>
                        </div>

                    </div>

                </div>

                <p
                    class="fade-in mt-14 text-center
                           font-serif text-2xl italic leading-relaxed text-charcoal/80
                           md:text-3xl"
                >
                    You don't direct a single vendor. You don't move a single chair.
                    You just enjoy your special day.
                </p>

            </div>
        </section>


        <!-- =========================================================
             VENUE DETAILS
        ========================================================== -->
        <section class="bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        What's gathered into the package
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        You're not renting a room.
                        You're buying a fully ran day.
                    </h2>

                    <p
                        class="fade-in delay-2 mx-auto mt-6 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        Eight things, one contract. Each piece coordinated by
                        the same team that has hosted celebrations on this
                        property since the beginning.
                    </p>

                </div>


                <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                    <div
                        class="fade-in group overflow-hidden rounded-sm
                               border border-sage/20
                               bg-cream-warm
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div class="aspect-[4/3] w-full overflow-hidden">
                            <img
                                src="/media/img/garden-at-night.jpg"
                                alt="Exclusive garden access at Himaya Garden"
                                class="h-full w-full object-cover
                                       transition-transform duration-700
                                       group-hover:scale-[1.05]"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-7">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                01 · Exclusive access
                            </p>

                            <h3 class="mt-2 font-serif text-2xl text-charcoal">
                                11 hours in the garden
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Ceremony lawn and reception garden. Getting-ready
                                suite. Private use of the property during your
                                rental window.
                            </p>
                        </div>
                    </div>


                    <div
                        class="fade-in delay-1 group overflow-hidden rounded-sm
                               border border-sage/20
                               bg-cream-warm
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div class="aspect-[4/3] w-full overflow-hidden">
                            <img
                                src="/media/img/collage-1.jpg"
                                alt="Furnished ceremony and reception setup"
                                class="h-full w-full object-cover
                                       transition-transform duration-700
                                       group-hover:scale-[1.05]"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-7">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                02 · Furnished, ready
                            </p>

                            <h3 class="mt-2 font-serif text-2xl text-charcoal">
                                Ceremony & reception, set
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Tables, chairs, ivory linens. Place settings,
                                glassware, and basic tableware in their places
                                before you arrive.
                            </p>
                        </div>
                    </div>


                    <div
                        class="fade-in delay-2 group overflow-hidden rounded-sm
                               border border-sage/20
                               bg-cream-warm
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div class="aspect-[4/3] w-full overflow-hidden">
                            <img
                                src="/media/img/hospitality-table.jpg"
                                alt="In-house buffet brunch or dinner"
                                class="h-full w-full object-cover
                                       transition-transform duration-700
                                       group-hover:scale-[1.05]"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-7">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                03 · In-house kitchen
                            </p>

                            <h3 class="mt-2 font-serif text-2xl text-charcoal">
                                Buffet brunch or dinner
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Menu consultation. Tasting for two. Staffed buffet
                                service. Filipino-inspired flavors and Dragonfly
                                Cakes®.
                            </p>
                        </div>
                    </div>


                    <div
                        class="fade-in delay-3 group overflow-hidden rounded-sm
                               border border-sage/20
                               bg-cream-warm
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div class="aspect-[4/3] w-full overflow-hidden">
                            <img
                                src="/media/img/event-high-tea.jpg"
                                alt="BYO bar and bartending service"
                                class="h-full w-full object-cover
                                       transition-transform duration-700
                                       group-hover:scale-[1.05]"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-7">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                04 · BYO bar
                            </p>

                            <h3 class="mt-2 font-serif text-2xl text-charcoal">
                                You bring it. We pour it.
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                You provide the alcohol. We bring the bartending
                                team, ice, basic mixers, and a self-serve iced tea
                                & lemonade station.
                            </p>
                        </div>
                    </div>


                    <div
                        class="fade-in delay-1 group overflow-hidden rounded-sm
                               border border-sage/20
                               bg-cream-warm
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div class="aspect-[4/3] w-full overflow-hidden">
                            <img
                                src="/media/img/event-wedding.jpg"
                                alt="Professional DJ and sound"
                                class="h-full w-full object-cover
                                       transition-transform duration-700
                                       group-hover:scale-[1.05]"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-7">
                            <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                05 · Music & sound
                            </p>

                            <h3 class="mt-2 font-serif text-2xl text-charcoal">
                                Professional DJ, 5 hours
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
