---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Wedding Venue in Tucson | Himaya Garden"
    description="Beautiful garden wedding venue in Tucson, Arizona. Intimate ceremonies, elegant receptions, and Filipino-inspired catering for meaningful celebrations."
>
    <main>

        <!-- =========================================================
             HERO
        ========================================================== -->
        <section class="relative isolate min-h-[92svh] overflow-hidden bg-warm-white text-charcoal">

            <!-- Background image -->
            <div class="absolute inset-0 opacity-40">
                <img
                    src="/media/img/hero-image.webp"
                    alt="Wedding ceremony in Himaya Garden"
                    class="h-full w-full object-cover object-center"
                    fetchpriority="high"
                    loading="eager"
                    decoding="async"
                />
            </div>

            <!-- Cinematic overlays -->
            <div class="absolute inset-0 bg-white/10"></div>

            <div
                class="absolute inset-0 bg-gradient-to-r
                       from-white/40 via-white/20 to-transparent"
            ></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/30 via-white/5 to-transparent"
            ></div>

            <!-- Subtle texture -->
            <div
                class="absolute inset-0 opacity-[0.045]"
                style="
                    background-image: radial-gradient(circle, #ffffff 1px, transparent 1px);
                    background-size: 30px 30px;
                "
            ></div>

            <!-- Hero content -->
            <div
                class="relative z-10 flex min-h-[92svh] items-end
                       mx-auto max-w-7xl
                       px-6 pb-16 pt-32
                       md:px-12 md:pb-20
                       lg:px-20 lg:pb-24
                       xl:px-32"
            >
                <div class="max-w-5xl">

                    <div
                        class="fade-in flex items-center gap-3
                               text-xs font-medium uppercase
                               tracking-[0.28em] text-sage
                               md:text-sm"
                    >
                        <span class="h-px w-10 bg-sage/60"></span>
                        Wedding celebrations
                    </div>

                    <h1
                        class="fade-in delay-1 mt-5 max-w-5xl
                               font-serif text-5xl font-light leading-[0.95]
                               tracking-tight text-charcoal
                               sm:text-6xl
                               md:text-7xl
                               lg:text-8xl
                               xl:text-[7rem]"
                    >
                        Your wedding,
                        <span class="block italic text-charcoal/80">
                            surrounded by beauty.
                        </span>
                    </h1>

                    <p
                        class="fade-in delay-2 mt-7 max-w-2xl
                               text-base leading-relaxed text-charcoal/75
                               md:text-lg lg:text-xl"
                    >
                        A Tucson venue designed for intimate ceremonies,
                        joyful celebrations, and the kind of hospitality that
                        makes your guests feel genuinely welcomed. From dawn
                        to dusk, the garden becomes the backdrop for your
                        unique love story.
                    </p>

                    <div class="fade-in delay-3 mt-8 flex flex-wrap items-center gap-4">
                        <a
                            href="/contact"
                            class="group inline-flex items-center justify-center
                                   bg-sage px-7 py-4
                                   text-sm font-medium uppercase
                                   tracking-[0.14em] text-warm-white
                                   transition-all duration-300
                                   hover:-translate-y-0.5
                                   hover:bg-sage-dark hover:shadow-xl"
                        >
                            <span>Schedule a Wedding Consultation</span>
                            <span
                                class="ml-4 transition-transform duration-300
                                       group-hover:translate-x-1"
                            >
                                →
                            </span>
                        </a>

                        <a
                            href="/events"
                            class="group inline-flex items-center gap-3
                                   px-2 py-4
                                   text-sm uppercase tracking-[0.14em]
                                   text-sage"
                        >
                            <span>View Upcoming Celebrations</span>
                            <span
                                class="h-px w-8 bg-sage/50
                                       transition-all duration-300
                                       group-hover:w-12 group-hover:bg-sage"
                            ></span>
                        </a>
                    </div>

                    <!-- Venue snapshot -->
                    <div
                        class="fade-in delay-4 mt-10 flex flex-wrap
                               items-center gap-x-7 gap-y-3
                               text-sm text-stone"
                    >
                        <span>120 seated capacity</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>4.9 guest satisfaction</span>

                        <span class="hidden h-1 w-1 rounded-full bg-sage/40 sm:block"></span>

                        <span>Full catering available</span>
                    </div>
                </div>
            </div>

            <!-- Scroll cue -->
            <div
                class="absolute bottom-7 right-6 z-10 hidden
                       items-center gap-3
                       text-[10px] uppercase tracking-[0.25em]
                       text-charcoal/50
                       sm:flex md:right-12
                       lg:right-20 xl:right-32"
            >
                <span>Explore the garden</span>
                <span class="h-10 w-px bg-charcoal/20"></span>
            </div>
        </section>


        <!-- =========================================================
             INTRO / POSITIONING
        ========================================================== -->
        <section class="relative overflow-hidden bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="pointer-events-none absolute left-0 top-0
                       h-64 w-64 -translate-x-1/2 -translate-y-1/2
                       rounded-full border border-sage/10"
            ></div>

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >
                <div class="mx-auto max-w-4xl text-center">

                    <p class="section-label fade-in">
                        Why couples choose Himaya
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        A venue that feels personal, not corporate.
                    </h2>

                    <p
                        class="fade-in delay-2 mx-auto mt-6 max-w-2xl
                               text-lg leading-relaxed text-stone"
                    >
                        A garden setting, meaningful spaces, and thoughtful
                        hospitality come together to create a celebration
                        that feels unmistakably yours.
                    </p>

                </div>


                <div class="mt-14 grid gap-5 lg:grid-cols-3">

                    <article
                        class="fade-in group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                💍
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Naturally photogenic
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                Every angle tells a story. The garden is your
                                backdrop — no extra décor needed, though we
                                welcome yours.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-1 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🌿
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Meaningful ceremony spaces
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                Layered garden settings for intimate vows and
                                flexible room for your unique rituals and
                                traditions.
                            </p>
                        </div>
                    </article>


                    <article
                        class="fade-in delay-2 group relative overflow-hidden
                               rounded-sm border border-sage/20
                               bg-cream-warm p-8
                               transition-all duration-500
                               hover:-translate-y-1 hover:shadow-xl hover:border-sage/40"
                    >
                        <div
                            class="absolute right-0 top-0
                                   h-24 w-24 translate-x-1/3 -translate-y-1/3
                                   rounded-full border border-sand/20"
                        ></div>

                        <div class="relative">
                            <div
                                class="mb-7 flex h-12 w-12 items-center
                                       justify-center rounded-full
                                       bg-sage/15 text-2xl"
                            >
                                🍽️
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Culinary heritage
                            </h3>

                            <p class="mt-4 leading-relaxed text-stone">
                                Filipino-inspired menus rooted in family
                                tradition, or fully custom menus shaped around
                                your vision.
                            </p>
                        </div>
                    </article>

                </div>
            </div>
        </section>


        <!-- =========================================================
             CEREMONY / RECEPTION STORY
        ========================================================== -->
        <section class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr]">

                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Your ceremony
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            From vows to reception, a flow that feels intentional.
                        </h2>

                        <div class="fade-in delay-2 mt-7 space-y-5 text-lg leading-relaxed text-stone">
                            <p>
                                We believe your wedding should reflect who you are —
                                your values, your traditions, your joy.
                            </p>

                            <p>
                                Our team works closely with you to design every
                                moment: the ceremony setting, the processional,
                                the gathering spaces, the dining experience. We
                                handle the logistics so you can be present for
                                the magic.
                            </p>
                        </div>

                    </div>


                    <!-- Experience cards -->
                    <div class="grid gap-5">

                        <div
                            class="fade-in relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Ceremony
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    01
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Sacred space for your vows
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Intimate settings among greenery, with flexible
                                configurations for your ceremony style.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-1 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Reception
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    02
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                Celebration and connection
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                Multiple garden spaces for cocktails, dining,
                                dancing, and moments of quiet togetherness.
                            </p>
                        </div>


                        <div
                            class="fade-in delay-2 relative overflow-hidden
                                   border-l-4 border-l-sage border border-sage/20 bg-warm-white
                                   p-7 md:p-8"
                        >
                            <div class="mb-4 flex items-center justify-between">
                                <p class="text-xs uppercase tracking-[0.2em] text-sage font-semibold">
                                    Sunset magic
                                </p>

                                <span class="text-sm text-gold font-semibold">
                                    03
                                </span>
                            </div>

                            <h3 class="font-serif text-2xl text-charcoal">
                                That golden desert light
                            </h3>

                            <p class="mt-3 leading-relaxed text-stone">
                                The garden transforms during golden hour — no extra
                                lighting needed, just pure Tucson beauty.
                            </p>
                        </div>

                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             VENUE DETAILS
        ========================================================== -->
        <section class="bg-warm-white py-20 md:py-24 lg:py-28">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="mx-auto max-w-3xl text-center">

                    <p class="section-label fade-in">
                        The details
                    </p>

                    <h2
                        class="fade-in delay-1 mt-4
                               font-serif text-4xl font-light
                               leading-tight text-charcoal
                               md:text-5xl lg:text-6xl"
                    >
                        Everything you need to say yes.
                    </h2>

                </div>


                <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                    <div
                        class="fade-in group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            ⏰
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Timing
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            Ceremony at 4pm, reception until sunset.
                            Flexible for your vision.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-1 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            🚗
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Parking
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            On-site parking complimentary for all guests.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-2 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            🍽️
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Catering
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            In-house catering or approved outside vendors welcome.
                        </p>
                    </div>


                    <div
                        class="fade-in delay-3 group rounded-sm
                               border border-sage/20
                               bg-cream-warm p-7
                               transition-all duration-300
                               hover:-translate-y-1 hover:shadow-lg hover:border-sage/40"
                    >
                        <div
                            class="mb-5 flex h-11 w-11 items-center
                                   justify-center rounded-full
                                   bg-sage/15 text-xl
                                   transition-transform duration-300
                                   group-hover:scale-110"
                        >
                            📸
                        </div>

                        <h3 class="font-serif text-2xl text-charcoal">
                            Photography
                        </h3>

                        <p class="mt-3 leading-relaxed text-stone">
                            Multiple backdrops and lighting throughout the day.
                        </p>
                    </div>

                </div>
            </div>
        </section>


        <!-- =========================================================
             FOOD / HOSPITALITY
        ========================================================== -->
        <section class="bg-cream py-24 md:py-32 lg:py-36">

            <div
                class="mx-auto max-w-7xl px-6
                       md:px-12 lg:px-20 xl:px-32"
            >

                <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">

                    <!-- Image -->
                    <div
                        class="fade-in relative overflow-hidden rounded-sm
                               shadow-xl"
                    >
                        <img
                            src="/media/img/high tea two women eating at the table.jpeg"
                            alt="Wedding reception meal at Himaya Garden"
                            class="aspect-[4/3] h-full w-full object-cover
                                   transition-transform duration-700
                                   hover:scale-[1.03]"
                            loading="lazy"
                        />

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-charcoal/20 to-transparent"
                        ></div>
                    </div>


                    <!-- Content -->
                    <div>

                        <p class="section-label fade-in">
                            Your feast
                        </p>

                        <h2
                            class="fade-in delay-1 mt-4
                                   font-serif text-4xl font-light
                                   leading-tight text-charcoal
                                   md:text-5xl lg:text-6xl"
                        >
                            Food that makes your guests linger.
                        </h2>

                        <p
                            class="fade-in delay-2 mt-6
                                   text-lg leading-relaxed text-stone"
                        >
                            Your wedding menu is part of your story. We create
                            menus rooted in Filipino heritage yet fully
                            customizable to your tastes, dietary needs, and vision.
                        </p>

                        <ul class="fade-in delay-3 mt-8 space-y-4 text-stone">

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Heritage-inspired or fully custom menus</span>
                            </li>

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Cocktail hour through dessert service</span>
                            </li>

                            <li class="flex gap-3">
                                <span class="mt-1 text-sage">◈</span>
                                <span>Thoughtful wine and beverage pairings</span>
                            </li>

                        </ul>

                    </div>

                </div>
            </div>
        </section>
        <section class="relative isolate overflow-hidden bg-warm-white py-32 md:py-40">

            <!-- Background -->
            <div class="absolute inset-0">

                <img
                    src="/media/img/AG1_4.jpg"
                    alt="Wedding celebration at Himaya Garden"
                    class="h-full w-full object-cover opacity-30"
                    loading="lazy"
                />

            </div>

            <div class="absolute inset-0 bg-white/60"></div>

            <div
                class="absolute inset-0 bg-gradient-to-t
                       from-white/40 via-white/10 to-white/20"
            ></div>


            <!-- Content -->
            <div
                class="relative z-10 mx-auto max-w-4xl
                       px-6 text-center text-charcoal
                       md:px-12 lg:px-20 xl:px-32"
            >

                <p class="section-label text-sage fade-in">
                    Ready to say yes?
                </p>

                <h2
                    class="fade-in mt-4
                           font-serif text-4xl font-light
                           leading-tight
                           sm:text-5xl
                           md:text-6xl"
                >
                    Let's plan a wedding that feels like home.
                </h2>

                <p
                    class="fade-in delay-1 mx-auto mt-6 max-w-2xl
                           text-lg leading-relaxed text-charcoal/75
                           md:text-xl"
                >
                    Connect with us to explore availability, walk the garden,
                    and begin shaping your wedding vision.
                </p>

                <div
                    class="fade-in delay-2 mt-9
                           flex flex-wrap justify-center gap-4"
                >

                    <a
                        href="/contact"
                        class="group inline-flex items-center justify-center
                               bg-sage px-7 py-4
                               text-sm font-medium uppercase
                               tracking-[0.14em] text-warm-white
                               transition-all duration-300
                               hover:-translate-y-0.5
                               hover:bg-sage-dark hover:shadow-xl"
                    >
                        <span>Schedule a Wedding Tour</span>

                        <span
                            class="ml-4 transition-transform duration-300
                                   group-hover:translate-x-1"
                        >
                            →
                        </span>
                    </a>

                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center
                               border border-sage/40
                               px-7 py-4
                               text-sm font-medium uppercase
                               tracking-[0.14em] text-sage
                               transition-all duration-300
                               hover:bg-sage hover:text-white"
                    >
                        Request Pricing
                    </a>

                </div>

            </div>
        </section>

        <div
            class="fixed inset-x-0 bottom-0 z-40
                   border-t border-charcoal/10
                   bg-warm-white/95 p-3
                   shadow-[0_-8px_30px_rgba(0,0,0,0.08)]
                   backdrop-blur-md
                   md:hidden"
        >
            <a
                href="/contact"
                class="flex w-full items-center justify-center
                       bg-charcoal px-5 py-3.5
                       text-sm font-medium uppercase
                       tracking-[0.12em] text-white"
            >
                Schedule a Wedding Tour
            </a>
        </div>

    </main>
</BaseLayout>


<style>
    .fade-in {
        opacity: 0;
        transform: translateY(12px);
        animation: fadeInUp 0.7s ease forwards;
    }

    .fade-in.delay-1 {
        animation-delay: 0.08s;
    }

    .fade-in.delay-2 {
        animation-delay: 0.16s;
    }

    .fade-in.delay-3 {
        animation-delay: 0.24s;
    }

    .fade-in.delay-4 {
        animation-delay: 0.32s;
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .fade-in {
            opacity: 1;
            transform: none;
            animation: none;
        }

        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>