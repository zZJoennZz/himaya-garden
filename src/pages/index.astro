---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import EventCalendar from '../components/EventCalendar.astro';
---

<style>
    .home-flow {
        display: flex;
        flex-direction: column;
    }

    .home-flow > .home-hero { order: 1; }
    .home-flow > .home-social-proof { order: 2; }
    .home-flow > .home-ways { order: 3; }
    .home-flow > .home-high-tea { order: 4; }
    .home-flow > .home-garden { order: 5; }
    .home-flow > .home-food { order: 6; }
    .home-flow > .home-calendar { order: 7; }
    .home-flow > .home-included { order: 8; }
    .home-flow > .home-founder { order: 9; }
    .home-flow > .home-reviews { order: 10; }
    .home-flow > .home-cta { order: 11; }

    h1 {
        font-family: 'Inter', sans-serif, serif !important;
    }
</style>
<BaseLayout title="Himaya Garden — A Desert Sanctuary for Meaningful Gatherings">
    <main class="home-flow">
        <section class="home-hero relative min-h-screen flex flex-col justify-between overflow-hidden pt-34 md:pt-40 pb-24 md:pb-32">
            <div class="absolute inset-0 z-0">
                <div class="hero-slide active" data-slide="0">
                    <img src="/media/img/hero-image.webp" alt="Himaya Garden wedding ceremony" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-charcoal/30"></div>
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-cream/40"></div>
                </div>
                <div class="hero-slide" data-slide="1">
                    <img src="/media/img/aug-high-tea-banner.jpg" alt="Himaya Garden sunset" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-charcoal/30"></div>
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-cream/40"></div>
                </div>
            </div>

            <div class="relative z-[3] text-center text-white max-w-4xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 w-full">
                <div class="hero-content" data-slide="0">
                    <p class="fade-in delay-1 text-xs md:text-sm tracking-[0.35em] uppercase text-white/80 mb-4">Private events + experiences</p>
                    <h1 class="pt-2 md:pt-6 fade-in delay-2 text-3xl md:text-5xl lg:text-6xl tracking-[0.08em] uppercase text-white font-light leading-none">
                        A Tucson Garden Venue for Meaningful Gatherings
                    </h1>
                    <p class="fade-in delay-3 text-white/80 font-light text-base md:text-lg max-w-2xl mx-auto mt-4 md:mt-6">
                        Weddings, private celebrations, retreats, high tea, and creative experiences rooted in Filipino hospitality, beautiful food, and the quiet magic of the desert garden.
                    </p>
                </div>

                <div class="hero-content hidden" data-slide="1">
                    <p class="fade-in delay-1 text-xs md:text-sm tracking-[0.35em] uppercase text-white/80 mb-4">A signature experience</p>
                    <h1 class="pt-2 md:pt-6 fade-in delay-2 text-3xl md:text-5xl lg:text-6xl tracking-[0.08em] uppercase text-white font-light leading-none">
                        Morning High Tea Returns
                    </h1>
                    <p class="fade-in delay-3 text-white/80 font-light text-base md:text-lg max-w-2xl mx-auto mt-4 md:mt-6">
                        Filipino-inspired menus, warm service, and a slow, beautiful afternoon among the garden and tea house.
                    </p>
                </div>
            </div>

            <div class="relative z-[3] text-center text-white max-w-4xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32 w-full">
                <div class="hero-buttons" data-slide="0">
                    <div class="fade-in delay-4 flex flex-wrap gap-4 justify-center">
                        <a href="/contact" class="inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-sm border border-sage bg-sage px-8 py-4 font-sans text-sm font-medium uppercase tracking-[0.15em] text-white transition-all duration-[600ms] ease-out hover:bg-white hover:text-charcoal hover:border-white active:scale-95 cursor-pointer shadow-lg">
                            Book a Garden Tour
                        </a>
                        <a href="/events" class="inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-sm border border-white/80 bg-transparent px-8 py-4 font-sans text-sm font-medium uppercase tracking-[0.15em] text-white transition-all duration-[600ms] ease-out hover:bg-white hover:text-charcoal hover:border-white active:scale-95 cursor-pointer">
                            Explore Upcoming Experiences
                        </a>
                    </div>
                </div>

                <div class="hero-buttons hidden" data-slide="1">
                    <div class="fade-in delay-4 flex flex-wrap gap-4 justify-center">
                        <a href="/private-events" class="inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-sm border border-white bg-white px-8 py-4 font-sans text-sm font-medium uppercase tracking-[0.15em] text-charcoal transition-all duration-[600ms] ease-out hover:bg-sage hover:text-white hover:border-sage active:scale-95 cursor-pointer">
                            Reserve High Tea
                        </a>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-20 left-1/2 z-[3] -translate-x-1/2 flex gap-3">
                <button class="hero-dot active" data-slide="0" aria-label="Slide 1"></button>
                <button class="hero-dot" data-slide="1" aria-label="Slide 2"></button>
            </div>

            <div class="absolute bottom-10 left-1/2 z-[3] -translate-x-1/2 animate-bounce-slow">
                <div class="w-px h-12 bg-white/40"></div>
            </div>
        </section>

        <section class="home-social-proof py-16 md:py-20 bg-warm-white">
            <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center mb-10">
                    <p class="section-label fade-in">Social proof</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">4.9 Google rating</h2>
                    <p class="fade-in delay-2 mt-3 text-sage text-lg">★★★★★ from guests who have gathered with us</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <blockquote class="fade-in border-t border-sage/20 pt-6">
                        <p class="text-stone leading-relaxed">“The team went above and beyond. They made us feel like family throughout the planning process, and our intimate wedding was beautiful.”</p>
                        <cite class="block mt-4 text-sm text-charcoal not-italic">Samantha S. · Wedding</cite>
                    </blockquote>
                    <blockquote class="fade-in delay-1 border-t border-sage/20 pt-6">
                        <p class="text-stone leading-relaxed">“The setting was beautiful and calm, and the Filipino-inspired menu felt thoughtful, memorable, and deeply personal.”</p>
                        <cite class="block mt-4 text-sm text-charcoal not-italic">Riley A. · High Tea</cite>
                    </blockquote>
                    <blockquote class="fade-in delay-2 border-t border-sage/20 pt-6">
                        <p class="text-stone leading-relaxed">“Everything was beautifully put together. The yoga, sound bath, food, and ambiance made it an experience I will absolutely repeat.”</p>
                        <cite class="block mt-4 text-sm text-charcoal not-italic">Stiesha S. · Retreat</cite>
                    </blockquote>
                </div>
            </div>
        </section>

        <section class="home-ways py-24 md:py-32 bg-cream">
            <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto mb-14">
                    <p class="section-label fade-in">Three ways to experience Himaya</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-light text-charcoal">Find your reason to gather</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <a href="/contact" class="fade-in group relative overflow-hidden rounded-sm aspect-[4/5]">
                        <img src="/media/img/celebration.png" alt="Celebration at Himaya Garden" class="w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 to-transparent flex items-end p-8">
                            <div>
                                <p class="text-xs tracking-[0.25em] uppercase text-white/70">Celebrate</p>
                                <h3 class="font-serif text-3xl text-white mt-2">Weddings & private celebrations</h3>
                            </div>
                        </div>
                    </a>
                    <a href="/events" class="fade-in delay-1 group relative overflow-hidden rounded-sm aspect-[4/5]">
                        <img src="/media/img/high tea two women eating at the table.jpeg" alt="High Tea experience at Himaya Garden" class="w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 to-transparent flex items-end p-8">
                            <div>
                                <p class="text-xs tracking-[0.25em] uppercase text-white/70">Experience</p>
                                <h3 class="font-serif text-3xl text-white mt-2">High Tea, edible arts & workshops</h3>
                            </div>
                        </div>
                    </a>
                    <a href="/contact" class="fade-in delay-2 group relative overflow-hidden rounded-sm aspect-[4/5]">
                        <img src="/media/img/hero-image.webp" alt="Gathering at Himaya Garden" class="w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 to-transparent flex items-end p-8">
                            <div>
                                <p class="text-xs tracking-[0.25em] uppercase text-white/70">Gather</p>
                                <h3 class="font-serif text-3xl text-white mt-2">Retreats, corporate & community</h3>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <section class="home-high-tea py-24 md:py-32 bg-warm-white">
            <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <div>
                        <p class="section-label fade-in">Your gateway product</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6 text-charcoal">Signature High Tea</h2>
                        <div class="fade-in delay-2">
                            <p class="text-lg text-stone leading-relaxed mb-5">
                                Our most loved gathering is also our easiest way to experience the magic of Himaya: elegant, intimate, and rooted in the warmth of Filipino hospitality.
                            </p>
                            <p class="text-stone leading-relaxed mb-6">
                                Built around seasonal sweets, savory bites, artisan teas, and warm conversation, our high tea invites guests to slow down and savor what matters most — the stories, the flavors, the people beside them.
                            </p>
                            <ul class="list-none mb-8">
                                <li class="flex items-start gap-3 py-3 text-stone text-[0.9375rem] font-light border-b border-charcoal/5">
                                    <span class="text-sage text-xl leading-none">◈</span> Filipino-inspired menus with tea service and handcrafted sweets
                                </li>
                                <li class="flex items-start gap-3 py-3 text-stone text-[0.9375rem] font-light border-b border-charcoal/5">
                                    <span class="text-sage text-xl leading-none">◈</span> Ideal for bridal showers, birthdays, mother-daughter dates, and intimate gatherings
                                </li>
                                <li class="flex items-start gap-3 py-3 text-stone text-[0.9375rem] font-light border-b border-charcoal/5">
                                    <span class="text-sage text-xl leading-none">◈</span> A memorable, approachable entry point to the Himaya experience
                                </li>
                            </ul>
                        </div>
                        <div class="fade-in delay-3 flex flex-wrap gap-4 items-center">
                            <a href="/private-events" class="btn-primary">Reserve High Tea</a>
                            <a href="/events" class="btn-secondary">View Upcoming Dates</a>
                        </div>
                    </div>
                    <div class="fade-in delay-2">
                        <img src="/media/img/high tea two women eating at the table.jpeg" alt="High Tea at Himaya Garden" class="w-full h-auto rounded-sm" />
                    </div>
                </div>
            </div>
        </section>

        <section class="home-garden py-24 md:py-32 bg-cream">
            <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <div class="order-2 lg:order-1">
                        <p class="section-label fade-in">The garden</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-8 text-charcoal">
                            A visual, sensory, emotional experience
                        </h2>
                        <div class="fade-in delay-2 space-y-5 text-stone leading-relaxed text-lg">
                            <p>
                                Himaya Garden feels like a hidden sanctuary in the middle of Tucson — where soft light, greenery, and warm natural textures settle the body and open the heart.
                            </p>
                            <p>
                                It is desert and bloom, ceremony and conversation, stillness and celebration. The space invites guests to slow down, look around, and feel the moment.
                            </p>
                            <p>
                                Every angle is intentionally beautiful, but never forced. The garden already carries the story. We simply create a place where people can gather inside it.
                            </p>
                        </div>
                        <div class="mt-8 fade-in delay-3 grid grid-cols-2 gap-4 text-sm text-charcoal">
                            <div class="bg-warm-white border border-sage/10 p-4 rounded-sm">
                                <div class="text-2xl mb-2">🌿</div>
                                <p class="font-medium">Layered outdoor spaces</p>
                            </div>
                            <div class="bg-warm-white border border-sage/10 p-4 rounded-sm">
                                <div class="text-2xl mb-2">🌤️</div>
                                <p class="font-medium">Golden-hour ambience</p>
                            </div>
                            <div class="bg-warm-white border border-sage/10 p-4 rounded-sm">
                                <div class="text-2xl mb-2">✨</div>
                                <p class="font-medium">Intimate yet elevated</p>
                            </div>
                            <div class="bg-warm-white border border-sage/10 p-4 rounded-sm">
                                <div class="text-2xl mb-2">📍</div>
                                <p class="font-medium">Midtown Tucson</p>
                            </div>
                        </div>
                    </div>
                    <div class="order-1 lg:order-2 fade-in delay-2">
                        <img src="/media/img/AG1_4.jpg" alt="Himaya Garden setting" class="w-full h-full object-cover rounded-sm shadow-sm" />
                    </div>
                </div>
            </div>
        </section>

        <section class="home-food py-24 md:py-32 bg-warm-white">
            <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col gap-4">
                            <div class="rounded-sm overflow-hidden aspect-[4/5]">
                                <img src="/media/img/collage-2.webp" alt="Himaya Garden catering" class="w-full h-full object-cover transition-transform duration-[2000ms] hover:scale-[1.05]" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-4 mt-8">
                            <div class="rounded-sm overflow-hidden aspect-[4/5]">
                                <img src="/media/img/collage-3_4.webp" alt="Filipino-inspired cuisine" class="w-full h-full object-cover transition-transform duration-[2000ms] hover:scale-[1.05]" />
                            </div>
                            <div class="rounded-sm overflow-hidden aspect-[4/3]">
                                <img src="/media/img/collage-3_7.webp" alt="Garden dining" class="w-full h-full object-cover transition-transform duration-[2000ms] hover:scale-[1.05]" />
                            </div>
                        </div>
                    </div>
                    <div>
                        <p class="section-label fade-in">Food that carries memory</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-8 text-charcoal">
                            Filipino roots, culinary differentiation, and heartfelt hospitality
                        </h2>
                        <div class="fade-in delay-2">
                            <p class="text-lg text-stone leading-relaxed mb-5">
                                Food at Himaya is never generic. It is rooted in heritage, shaped by generations, and built around the idea that the table is where people feel seen.
                            </p>
                            <p class="text-stone leading-relaxed mb-5">
                                Our menus reflect the warmth of Filipino family gatherings — generous, soulful, sensory — while also standing apart with a refined, intentional, garden-to-table sensibility.
                            </p>
                            <p class="text-stone leading-relaxed mb-5">
                                From ube pastries to savory favorites, each plate tells a story of culture, memory, and care. Guests remember the food because it feels personal, not formulaic.
                            </p>
                        </div>
                        <div class="fade-in delay-3 flex flex-wrap gap-4 items-center mt-8">
                            <a href="/contact" class="btn-secondary">Inquire About Catering</a>
                            <a href="/private-events" class="btn-primary">See Private Event Offerings</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="home-calendar py-24 md:py-32 bg-cream-warm">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center mb-12">
                    <p class="section-label fade-in">Dynamic calendar</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light leading-tight text-charcoal mb-4">
                        Upcoming Experiences
                    </h2>
                    <p class="fade-in delay-2 text-lg text-stone leading-relaxed max-w-2xl mx-auto">
                        A rotating calendar of gatherings, workshops, high tea, and seasonal experiences designed to bring people together in a warm and spacious garden setting.
                    </p>
                </div>
                <div class="fade-in delay-3">
                    <EventCalendar />
                </div>
                <div class="text-center mt-12 fade-in delay-4">
                    <a href="/events" class="btn-secondary">Explore All Experiences</a>
                </div>
            </div>
        </section>

        <section class="home-included py-20 md:py-24 bg-cream">
            <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <p class="section-label fade-in">What’s included</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal">Starting investment</h2>
                    <p class="fade-in delay-2 mt-4 text-lg text-stone leading-relaxed">Every gathering begins with a conversation, a walk through the garden, and a plan shaped around your people.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="fade-in bg-warm-white p-7 border border-sage/10 rounded-sm"><h3 class="font-serif text-2xl text-charcoal mb-3">The setting</h3><p class="text-stone leading-relaxed">Private access to layered garden spaces, the tea house, and on-site parking for your guests.</p></div>
                    <div class="fade-in delay-1 bg-warm-white p-7 border border-sage/10 rounded-sm"><h3 class="font-serif text-2xl text-charcoal mb-3">The essentials</h3><p class="text-stone leading-relaxed">Thoughtful hosting, in-house catering options, and a venue plan shaped around your event vision.</p></div>
                    <div class="fade-in delay-2 bg-warm-white p-7 border border-sage/10 rounded-sm"><h3 class="font-serif text-2xl text-charcoal mb-3">Your starting point</h3><p class="text-stone leading-relaxed">Investment varies by guest count, date, menu, and experience. <a href="/contact" class="text-sage hover:underline">Request details</a>.</p></div>
                </div>
            </div>
        </section>

        <section class="home-founder py-20 md:py-24 bg-warm-white">
            <div class="max-w-5xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-10 items-center">
                    <img src="/media/img/Odette and Milana posing in front of Himaya Garden Mural.webp" alt="Odette and Milana D'Aniello, founders of Himaya Garden" class="w-full aspect-[4/3] object-cover rounded-sm" />
                    <div>
                        <p class="section-label fade-in">Odette + Milana</p>
                        <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl font-light text-charcoal mb-5">The story behind Himaya</h2>
                        <p class="fade-in delay-2 text-lg text-stone leading-relaxed">A mother and daughter, third- and fourth-generation bakers, created Himaya Garden to make space for heritage, hospitality, and meaningful celebration. What began as a love for family recipes became a sanctuary for gathering — where food, culture, and care are woven into each experience.</p>
                        <a href="/about-us" class="btn-secondary inline-flex mt-7">Read Our Story</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="home-reviews py-24 md:py-32 bg-sage/10">
            <div class="max-w-7xl mx-auto text-center px-6 md:px-12 lg:px-20 xl:px-32">
                <div class="mb-12">
                    <p class="section-label fade-in">Reviews + press</p>
                    <h2 class="fade-in delay-1 font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight text-charcoal">
                        Loved by the Himaya community
                    </h2>
                </div>
                <GoogleReviews />
            </div>
        </section>

        <section class="home-cta relative py-32 md:py-40 text-center text-white overflow-hidden">
            <div class="absolute inset-0 z-0">
                <img src="/media/img/AG1_4.jpg" alt="Himaya Garden sunset" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-charcoal/50 z-[1]"></div>
            <div class="relative z-[2] max-w-3xl mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
                <p class="section-label text-white/80 fade-in">Come experience Himaya</p>
                <h2 class="fade-in font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-6">
                    Gather in a place that feels like memory in the making.
                </h2>
                <p class="fade-in delay-1 text-lg md:text-xl leading-relaxed mb-8 text-white/80">
                    Explore the garden, taste the food, and imagine your next meaningful gathering among lush greenery, warm hospitality, and a golden desert sky.
                </p>
                <div class="fade-in delay-2 flex flex-wrap gap-4 justify-center">
                    <a href="/contact" class="btn-primary">Book a Garden Tour</a>
                    <a href="/events" class="btn-secondary border-white text-white hover:bg-white hover:text-charcoal">Explore Upcoming Experiences</a>
                </div>
            </div>
        </section>
    </main>

    <script>
    // Hero Slideshow
    const heroSlides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const heroContents = document.querySelectorAll<HTMLElement>('.hero-content');
    const heroButtons = document.querySelectorAll<HTMLElement>('.hero-buttons');
    const heroDots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
    let currentHeroSlide: number = 0;
    let heroInterval: number | undefined;

    function showHeroSlide(index: number): void {
        // Update slides
        heroSlides.forEach((slide, i) => {
            slide.classList.toggle('active', i === index);
        });

        // Update content (h1 + paragraph)
        heroContents.forEach((content, i) => {
            content.classList.toggle('hidden', i !== index);
            if (i === index) {
                // Re-trigger fade animation for all child elements
                const fadeElements = content.querySelectorAll('.fade-in');
                fadeElements.forEach((el) => {
                    el.classList.remove('fade-in');
                    void (el as HTMLElement).offsetWidth;
                    el.classList.add('fade-in');
                });
            }
        });

        // Update buttons
        heroButtons.forEach((buttons, i) => {
            buttons.classList.toggle('hidden', i !== index);
            if (i === index) {
                // Re-trigger fade animation for all child elements
                const fadeElements = buttons.querySelectorAll('.fade-in');
                fadeElements.forEach((el) => {
                    el.classList.remove('fade-in');
                    void (el as HTMLElement).offsetWidth;
                    el.classList.add('fade-in');
                });
            }
        });

        // Update dots
        heroDots.forEach((dot, i) => {
            dot.classList.toggle('active', i === index);
        });

        currentHeroSlide = index;
    }

    function nextHeroSlide(): void {
        showHeroSlide((currentHeroSlide + 1) % heroSlides.length);
    }

