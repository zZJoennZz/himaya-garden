<script>
    // ============================================
// HERO SLIDESHOW
// ============================================
const heroSlides = document.querySelectorAll<HTMLElement>('.hero-slide');
const heroContents = document.querySelectorAll<HTMLElement>('.hero-content');
const heroButtons = document.querySelectorAll<HTMLElement>('.hero-buttons');
const heroDots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
let currentHeroSlide: number = 0;
let heroInterval: number | undefined;

function showHeroSlide(index: number): void {
    // Update slides
    heroSlides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
    });

    // Update content (h1 + paragraph)
    heroContents.forEach((content, i) => {
        content.classList.toggle('hidden', i !== index);
        if (i === index) {
            const fadeElements = content.querySelectorAll('.fade-in');
            fadeElements.forEach((el) => {
                el.classList.remove('fade-in');
                void (el as HTMLElement).offsetWidth;
                el.classList.add('fade-in');
            });
        }
    });

    // Update buttons
    heroButtons.forEach((buttons, i) => {
        buttons.classList.toggle('hidden', i !== index);
        if (i === index) {
            const fadeElements = buttons.querySelectorAll('.fade-in');
            fadeElements.forEach((el) => {
                el.classList.remove('fade-in');
                void (el as HTMLElement).offsetWidth;
                el.classList.add('fade-in');
            });
        }
    });

    // Update dots
    heroDots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
    });

    currentHeroSlide = index;
}

function nextHeroSlide(): void {
    showHeroSlide((currentHeroSlide + 1) % heroSlides.length);
}

function startHeroCarousel(): void {
    if (heroInterval !== undefined) {
        clearInterval(heroInterval);
    }
    heroInterval = window.setInterval(nextHeroSlide, 5000);
}

// Dot click handlers
heroDots.forEach((dot) => {
    dot.addEventListener('click', () => {
        if (heroInterval !== undefined) {
            clearInterval(heroInterval);
        }
        const slideIndex = parseInt(dot.dataset.slide || '0', 10);
        showHeroSlide(slideIndex);
        startHeroCarousel();
    });
});

// Start the carousel
startHeroCarousel();

// ============================================
// TESTIMONIAL CAROUSEL
// ============================================
const testimonialSlides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
const testimonialDots = document.querySelectorAll<HTMLButtonElement>('.testimonial-dot');
let currentTestimonialSlide: number = 0;
let testimonialInterval: number | undefined;

function showTestimonialSlide(index: number): void {
    testimonialSlides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
    });
    testimonialDots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
    });
    currentTestimonialSlide = index;
}

function nextTestimonialSlide(): void {
    showTestimonialSlide((currentTestimonialSlide + 1) % testimonialSlides.length);
}

function startTestimonialCarousel(): void {
    if (testimonialInterval !== undefined) {
        clearInterval(testimonialInterval);
    }
    testimonialInterval = window.setInterval(nextTestimonialSlide, 6000);
}

testimonialDots.forEach((dot) => {
    dot.addEventListener('click', () => {
        if (testimonialInterval !== undefined) {
            clearInterval(testimonialInterval);
        }
        const slideIndex = parseInt(dot.dataset.index || '0', 10);
        showTestimonialSlide(slideIndex);
        startTestimonialCarousel();
    });
});

startTestimonialCarousel();

// ============================================
// VIDEO CONTROLS
// ============================================
const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
const overlay = document.getElementById('videoOverlay') as HTMLElement | null;
const playButton = document.getElementById('playButton') as HTMLElement | null;

if (video && overlay && playButton) {
    // Click overlay to play/pause
    overlay.addEventListener('click', () => {
        if (video.paused) {
            video.play().catch((error: Error) => {
                console.warn('Video play failed:', error);
            });
            overlay.style.opacity = '0';
            overlay.style.pointerEvents = 'none';
        } else {
            video.pause();
            overlay.style.opacity = '1';
            overlay.style.pointerEvents = 'auto';
        }
    });

    // Show overlay when video ends
    video.addEventListener('ended', () => {
        overlay.style.opacity = '1';
        overlay.style.pointerEvents = 'auto';
    });

    // Hide overlay when video is playing
    video.addEventListener('play', () => {
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';
    });

    // Show overlay when video is paused
    video.addEventListener('pause', () => {
        if (!video.ended) {
            overlay.style.opacity = '1';
            overlay.style.pointerEvents = 'auto';
        }
    });
}
</script>

<style>
    /* Hero Slideshow Styles */
    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
    }
    .hero-slide.active {
        opacity: 1;
        z-index: 1;
    }
    .hero-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-slide .absolute {
        pointer-events: none;
    }

    .hero-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.4s ease;
        border: none;
        padding: 0;
    }
    .hero-dot.active {
        background-color: white;
        transform: scale(1.2);
    }

    .testimonial-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transition: opacity 1s ease-out;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
    }
    .testimonial-slide.active {
        opacity: 1;
        z-index: 2;
    }
    .testimonial-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--color-sage);
        opacity: 0.3;
        cursor: pointer;
        transition: all 0.4s ease;
        border: none;
        padding: 0;
    }
    .testimonial-dot.active {
        opacity: 1;
        transform: scale(1.2);
    }

    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
   }
    .animate-marquee {
        animation: marquee 40s linear infinite;
    }

    @keyframes bounce-slow {
        0%,
        100% {
            transform: translateX(-50%) translateY(0);
        }
        50% {
            transform: translateX(-50%) translateY(-10px);
        }
    }
    .animate-bounce-slow {
        animation: bounce-slow 2s infinite;
    }

    .fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 1.2s ease-out,
            transform 1.2s ease-out;
    }
    .fade-in.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .delay-1 {
        transition-delay: 0.2s;
    }
    .delay-2 {
        transition-delay: 0.4s;
    }
    .delay-3 {
        transition-delay: 0.6s;
    }
    .delay-4 {
        transition-delay: 0.8s;
    }
    .delay-5 {
        transition-delay: 1s;
    }

    .hidden {
        display: none;
    }
</style>
