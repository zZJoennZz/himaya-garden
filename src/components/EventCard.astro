---
export interface Props {
  event: {
    id: string;
    slug: string;
    title: string;
    date: string;
    time: string;
    endTime: string;
    location: string;
    shortDescription: string;
    thumbnail: string;
    image: string;
    category: string;
    featured?: boolean;
    price?: string;
    spotsAvailable?: number;
    spotsTotal?: number;
  };
  layout?: 'horizontal' | 'vertical';
}

const { event, layout = 'vertical' } = Astro.props;

// Format date
const eventDate = new Date(event.date + 'T00:00:00');
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const month = monthNames[eventDate.getMonth()];
const day = eventDate.getDate();
const weekday = dayNames[eventDate.getDay()];
const year = eventDate.getFullYear();

// Check if event is past
const isPast = new Date(event.date + 'T23:59:59') < new Date();

const isHorizontal = layout === 'horizontal';
---

<article class:list={[
  "group bg-white rounded-2xl shadow-sm border border-stone/10 overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:shadow-md",
  isHorizontal ? "flex flex-col md:flex-row" : "flex flex-col"
]}>
  <!-- Image -->
  <a 
    href={`/events/${event.slug}`} 
    class:list={[
      "relative overflow-hidden block",
      isHorizontal ? "md:w-2/5 h-56 md:h-auto shrink-0" : "w-full h-56"
    ]}
  >
    <img 
      src={event.thumbnail || event.image} 
      alt={event.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    {event.featured && (
      <span class="absolute top-4 left-4 px-3 py-1 bg-sage text-white text-xs font-medium tracking-wider uppercase rounded-full">
        Featured
      </span>
    )}
    {isPast && (
      <span class="absolute top-4 right-4 px-3 py-1 bg-charcoal/70 text-white text-xs font-medium tracking-wider uppercase rounded-full backdrop-blur-sm">
        Past Event
      </span>
    )}
    <div class="absolute bottom-0 left-0 right-0 h-1/3 bg-gradient-to-t from-charcoal/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
  </a>

  <!-- Content -->
  <div class:list={[
    "flex flex-col",
    isHorizontal ? "p-6 md:p-8 md:w-3/5 justify-between" : "p-6 md:p-8 flex-grow"
  ]}>
    <div>
      <!-- Category & Date Badge -->
      <div class="flex items-center gap-3 mb-4">
        <span class="text-sage text-xs font-medium tracking-[0.2em] uppercase">{event.category}</span>
        <span class="w-1 h-1 rounded-full bg-stone/30" />
        <span class="text-stone text-xs">{weekday}</span>
      </div>

      <!-- Title -->
      <a href={`/events/${event.slug}`} class="block group/title">
        <h3 class="font-serif text-xl md:text-2xl text-charcoal leading-tight mb-3 group-hover/title:text-sage transition-colors duration-300">
          {event.title}
        </h3>
      </a>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-stone mb-4">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-sage shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>{month} {day}, {year}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-sage shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{event.time} – {event.endTime}</span>
        </div>
      </div>

      <!-- Location -->
      <div class="flex items-start gap-2 text-sm text-stone mb-4">
        <svg class="w-4 h-4 text-sage shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>{event.location}</span>
      </div>

      <!-- Description -->
      <p class="text-stone text-sm leading-relaxed line-clamp-3 mb-5">
        {event.shortDescription}
      </p>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-4 border-t border-stone/10 mt-auto">
      <div class="flex items-center gap-3">
        {event.price && (
          <span class="text-charcoal font-medium text-sm">{event.price}</span>
        )}
        {event.spotsAvailable != null && event.spotsTotal != null && (
          <span class:list={[
            "text-xs px-2 py-1 rounded-full",
            event.spotsAvailable <= 5 ? "bg-terracotta/10 text-terracotta" : "bg-sage/10 text-sage"
          ]}>
            {event.spotsAvailable} spots left
          </span>
        )}
      </div>
      <a 
        href={`/events/${event.slug}`}
        class="inline-flex items-center gap-2 text-sage text-sm font-medium hover:text-sage-dark transition-colors"
      >
        Details
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>